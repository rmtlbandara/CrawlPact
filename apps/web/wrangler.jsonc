{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawlpact-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crawlpact-db",
      "database_id": "dd295b75-7376-4f05-8c50-fb0a63cc3cee",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  // @astrojs/cloudflare unconditionally enables its built-in KV-backed
  // Astro.session feature unless a session KV binding is already declared
  // (this app doesn't use Astro.session at all — real sessions are D1-backed,
  // ADR-0004 — but the adapter requires this binding to exist regardless).
  // Reuses the pre-existing "crawlpact-web-session" KV namespace (created by
  // an earlier deploy attempt hitting this same undocumented requirement)
  // rather than provisioning a new one.
  "kv_namespaces": [{ "binding": "SESSION", "id": "e092c1f4171243cf801b5af24070dfca" }],
  "triggers": {
    // Daily at 03:00 UTC. Drives both the monitoring sweep (lib/monitoring.ts
    // — re-scans domains whose monthly/weekly schedule is due) and the data
    // retention purge (lib/data-retention.ts) — see src/worker.ts's
    // `scheduled()` export.
    "crons": ["0 3 * * *"],
  },
  "vars": {
    "PUBLIC_APP_ENV": "production",
    "PUBLIC_SITE_URL": "https://crawlpact.com",
    "PADDLE_ENVIRONMENT": "production",
    // Live Paddle catalog created 2026-07-26 (see paddle:catalog-setup run) —
    // not secrets, per docs/deployment/CLOUDFLARE_CONFIGURATION.md.
    "PADDLE_PRICE_ID_SOLO": "pri_01kyfjzj3t4x2t4dqrmnkjj0r2",
    "PADDLE_PRICE_ID_PRO": "pri_01kyfjzj81k6w2ds6r6a2jcv93",
    "PADDLE_PRICE_ID_AGENCY": "pri_01kyfjzjc4tbhve9czw1dq2b1b",
    // Browser-exposed by design (Paddle.js needs it client-side) — not a secret.
    "PUBLIC_PADDLE_CLIENT_TOKEN": "live_7744585ebeca2976cd76da4b966",
    "BILLING_ENABLED": "true",
    "AUDIT_ENGINE_ENABLED": "false",
    // WebAuthn is not optional config — the browser strictly validates
    // `rpId`/origin against the page it's actually served from, so without
    // these matching the real deployed domain, every passkey ceremony
    // (registration and login) fails outright, for every user. Not a
    // secret (it's just the domain name), so it belongs in `vars`, not
    // `wrangler secret put` — found missing from this file entirely during
    // Part 3 Step 26's production configuration prep.
    "WEBAUTHN_RP_ID": "crawlpact.com",
    "WEBAUTHN_RP_ORIGIN": "https://crawlpact.com",
  },
  "env": {
    "preview": {
      // Distinct D1 database from production (SRS §28.20/§33: "separate
      // production and preview access" — found missing during Part 3 Step
      // 23/24's audit, since env.preview previously only overrode `vars`
      // and silently inherited the top-level `d1_databases` block, meaning
      // preview traffic — including admin testing — would read/write real
      // production data). Create with
      // `wrangler d1 create crawlpact-db-preview` and replace the
      // placeholder below, same as the production database above; never
      // reuse the production database_id here.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crawlpact-db-preview",
          "database_id": "e9c9f730-1f0d-4f4e-8775-db94126b12f0",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "SESSION", "id": "6c940efc0991477a88fa9f730c53b476" }],
      "vars": {
        "PUBLIC_APP_ENV": "preview",
        // Real serving origin: the `crawlpact-web-preview` Worker's
        // Cloudflare-assigned workers.dev hostname (account subdomain
        // "rmtlbandara", confirmed live 2026-07-27 — a dedicated
        // preview.crawlpact.com was considered but no such DNS record
        // exists, so it would 404/fail TLS if used here). Every
        // WebAuthn ceremony strictly validates rpId/origin against the
        // page actually serving the request, so this must exactly match
        // wherever preview is really deployed.
        "PUBLIC_SITE_URL": "https://crawlpact-web-preview.rmtlbandara.workers.dev",
        "WEBAUTHN_RP_ID": "crawlpact-web-preview.rmtlbandara.workers.dev",
        "WEBAUTHN_RP_ORIGIN": "https://crawlpact-web-preview.rmtlbandara.workers.dev",
        "PADDLE_ENVIRONMENT": "sandbox",
        // `vars` is a non-inheritable field per Wrangler's named-environment
        // model (env.preview does NOT merge with the top-level `vars` block
        // — it fully replaces it), so these have to be redeclared here even
        // though checkout/portal are already blocked in preview by
        // BILLING_ENABLED=false below. Without them, the schema's required
        // fields would be silently `undefined` on the deployed preview
        // Worker — found by `pnpm env:validate:preview` while building this
        // change. Same sandbox-placeholder convention as .env.example.
        "PADDLE_PRICE_ID_SOLO": "pri_sandbox_placeholder",
        "PADDLE_PRICE_ID_PRO": "pri_sandbox_placeholder",
        "PADDLE_PRICE_ID_AGENCY": "pri_sandbox_placeholder",
        "PUBLIC_PADDLE_CLIENT_TOKEN": "paddle_sandbox_client_token_placeholder",
        // Preview must never serve real checkouts even if a Paddle sandbox
        // value were ever mistakenly wired in here — see
        // packages/config/src/env.ts's cross-field validation, which also
        // hard-rejects PADDLE_ENVIRONMENT=production outside production.
        "BILLING_ENABLED": "false",
        "AUDIT_ENGINE_ENABLED": "false",
      },
    },
  },
}
