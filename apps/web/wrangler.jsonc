{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawlpact-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Phase 2 of the app-subdomain migration (ADR-0010,
  // docs/baseline/2026-09-09-app-subdomain-phase1/CLOUDFLARE_HOST_BOUNDARY_DESIGN.md):
  // production previously had no `run_worker_first`, so a prerendered public
  // page could be served directly off this ASSETS binding before
  // `src/worker.ts` ever ran — meaning the new app-host boundary check there
  // would never see the request. This selective array runs the Worker first
  // for every document/navigation path (closing that gap) while leaving the
  // handful of genuinely immutable, non-HTML, non-hostname-sensitive build
  // assets asset-first for performance, exactly mirroring Cloudflare's own
  // documented pattern (`["/api/*", "!/api/docs/*"]`). Re-derive this
  // exclusion list from `apps/web/public/`'s actual contents if it changes.
  // NOTE: this is a real production behavior change (every prerendered page
  // now runs through the Worker before being served) — it must be deployed
  // deliberately, with the regression evidence in
  // docs/baseline/2026-09-09-app-subdomain-phase2/, not silently alongside
  // an unrelated change.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/branding/*",
      "!/og/*",
      "!/favicon.png",
      "!/og-image.svg",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crawlpact-db",
      "database_id": "dd295b75-7376-4f05-8c50-fb0a63cc3cee",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  // @astrojs/cloudflare unconditionally enables its built-in KV-backed
  // Astro.session feature unless a session KV binding is already declared
  // (this app doesn't use Astro.session at all — real sessions are D1-backed,
  // ADR-0004 — but the adapter requires this binding to exist regardless).
  // Reuses the pre-existing "crawlpact-web-session" KV namespace (created by
  // an earlier deploy attempt hitting this same undocumented requirement)
  // rather than provisioning a new one.
  "kv_namespaces": [{ "binding": "SESSION", "id": "e092c1f4171243cf801b5af24070dfca" }],
  // Holds only agency-branding logo uploads (docs/data/D1_R2_DATA_PLACEMENT_POLICY.md's
  // 2026-07-30 revisit entry) — nothing else is ever written here.
  "r2_buckets": [{ "binding": "AGENCY_LOGOS", "bucket_name": "crawlpact" }],
  "triggers": {
    // Daily at 03:00 UTC. Drives both the monitoring sweep (lib/monitoring.ts
    // — re-scans domains whose monthly/weekly schedule is due) and the data
    // retention purge (lib/data-retention.ts) — see src/worker.ts's
    // `scheduled()` export.
    "crons": ["0 3 * * *"],
  },
  "vars": {
    "PUBLIC_APP_ENV": "production",
    "PUBLIC_SITE_URL": "https://crawlpact.com",
    "GOOGLE_CLIENT_ID": "913355566806-nk8ut4qmjqpigmife8q213vlc4ifdksp.apps.googleusercontent.com",
    "PADDLE_ENVIRONMENT": "production",
    // Live Paddle catalog created 2026-07-26 (see paddle:catalog-setup run) —
    // not secrets, per docs/deployment/CLOUDFLARE_CONFIGURATION.md.
    "PADDLE_PRICE_ID_SOLO": "pri_01kyfjzj3t4x2t4dqrmnkjj0r2",
    "PADDLE_PRICE_ID_PRO": "pri_01kyfjzj81k6w2ds6r6a2jcv93",
    "PADDLE_PRICE_ID_AGENCY": "pri_01kyfjzjc4tbhve9czw1dq2b1b",
    // Browser-exposed by design (Paddle.js needs it client-side) — not a secret.
    "PUBLIC_PADDLE_CLIENT_TOKEN": "live_7744585ebeca2976cd76da4b966",
    "BILLING_ENABLED": "true",
    "AUDIT_ENGINE_ENABLED": "true",
    // WebAuthn is not optional config — the browser strictly validates
    // `rpId`/origin against the page it's actually served from, so without
    // these matching the real deployed domain, every passkey ceremony
    // (registration and login) fails outright, for every user. Not a
    // secret (it's just the domain name), so it belongs in `vars`, not
    // `wrangler secret put` — found missing from this file entirely during
    // Part 3 Step 26's production configuration prep.
    "WEBAUTHN_RP_ID": "crawlpact.com",
    "WEBAUTHN_RP_ORIGIN": "https://crawlpact.com",
    // Phase 1 of the app-subdomain migration (ADR-0010): reserved future
    // application origin. Not yet attached as a Cloudflare Custom Domain
    // (no DNS record exists for it — verified 2026-09-09) and not read by
    // any route/redirect/CSRF/WebAuthn logic yet. Setting it here now is
    // purely non-behavioral configuration prep for Phase 2.
    "PUBLIC_APP_URL": "https://app.crawlpact.com",
  },
  "env": {
    "preview": {
      // Distinct D1 database from production (SRS §28.20/§33: "separate
      // production and preview access" — found missing during Part 3 Step
      // 23/24's audit, since env.preview previously only overrode `vars`
      // and silently inherited the top-level `d1_databases` block, meaning
      // preview traffic — including admin testing — would read/write real
      // production data). Create with
      // `wrangler d1 create crawlpact-db-preview` and replace the
      // placeholder below, same as the production database above; never
      // reuse the production database_id here.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crawlpact-db-preview",
          "database_id": "e9c9f730-1f0d-4f4e-8775-db94126b12f0",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "SESSION", "id": "6c940efc0991477a88fa9f730c53b476" }],
      // Distinct bucket from production, same reasoning as the D1/KV
      // separation above — never reuse the production bucket here.
      "r2_buckets": [{ "binding": "AGENCY_LOGOS", "bucket_name": "crawlpact-preview" }],
      // Phase 20, P0: full `assets` block redeclared (not just a
      // `run_worker_first` fragment) because Wrangler's non-inheritable-key
      // rule for named environments is ambiguous from the docs for `assets`
      // specifically — redeclaring `directory`/`binding` alongside it avoids
      // relying on inheritance semantics either way. `run_worker_first: true`
      // routes every preview request (including ones that would otherwise be
      // served directly as a static asset, bypassing the Worker entirely)
      // through `src/worker.ts` first, so its preview-only
      // `X-Robots-Tag: noindex` wrapper can actually see and stamp every
      // response — see that file's `fetchWithPreviewSearchIsolation` comment.
      // Production does not set this, so production asset-serving
      // performance is unaffected.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      // CrawlPact-owned Custom Domain migration (from the workers.dev
      // fallback below) — required before Google OAuth preview testing can
      // be registered, since Google Auth Platform needs a stable origin.
      // Cloudflare manages this hostname's DNS record and TLS certificate
      // once the Custom Domain is attached in the dashboard (Workers &
      // Pages → crawlpact-web-preview → Settings → Domains & Routes); no
      // DNS record should be created manually. A whole-hostname Custom
      // Domain, not a Worker Route with a `/*` pattern, because this
      // Worker is the origin, not a proxy in front of one.
      "routes": [
        {
          "pattern": "preview.crawlpact.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "PUBLIC_APP_ENV": "preview",
        // Canonical preview origin: the CrawlPact-owned Custom Domain
        // declared above. Cloudflare provisions its DNS/TLS once the
        // Custom Domain is attached (see the `routes` comment above) —
        // until then this hostname won't resolve yet. The Worker's
        // `*.workers.dev` address (account subdomain "rmtlbandara") may
        // remain reachable as a temporary operational fallback during
        // migration, but is no longer the canonical preview origin these
        // vars point at. Every WebAuthn ceremony strictly validates
        // rpId/origin against the page actually serving the request, so
        // these must exactly match wherever preview is really deployed.
        "PUBLIC_SITE_URL": "https://preview.crawlpact.com",
        // Phase 1 (ADR-0010): documented future preview app hostname only —
        // "app-preview.crawlpact.com" has no DNS record or Custom Domain
        // attached yet (do not attach it until Phase 2 host enforcement
        // exists, per the migration's static-assets-bypass hard gate).
        // Read by nothing today; kept in sync with the production `vars`
        // block above purely so config isn't ambiguous.
        "PUBLIC_APP_URL": "https://app-preview.crawlpact.com",
        "WEBAUTHN_RP_ID": "preview.crawlpact.com",
        "WEBAUTHN_RP_ORIGIN": "https://preview.crawlpact.com",
        // Same public Google Web OAuth Client ID as production's top-level
        // `vars` above — not a secret, safe to share across environments.
        // Google Sign-In on preview additionally requires
        // https://preview.crawlpact.com to be registered as an Authorized
        // JavaScript origin/redirect URI in Google Auth Platform before
        // preview OAuth testing is enabled (not yet done as of this
        // change — see docs/deployment/CLOUDFLARE_CONFIGURATION.md).
        "GOOGLE_CLIENT_ID": "913355566806-nk8ut4qmjqpigmife8q213vlc4ifdksp.apps.googleusercontent.com",
        "PADDLE_ENVIRONMENT": "sandbox",
        // `vars` is a non-inheritable field per Wrangler's named-environment
        // model (env.preview does NOT merge with the top-level `vars` block
        // — it fully replaces it), so these have to be redeclared here even
        // though checkout/portal are already blocked in preview by
        // BILLING_ENABLED=false below. Without them, the schema's required
        // fields would be silently `undefined` on the deployed preview
        // Worker — found by `pnpm env:validate:preview` while building this
        // change. Same sandbox-placeholder convention as .env.example.
        "PADDLE_PRICE_ID_SOLO": "pri_sandbox_placeholder",
        "PADDLE_PRICE_ID_PRO": "pri_sandbox_placeholder",
        "PADDLE_PRICE_ID_AGENCY": "pri_sandbox_placeholder",
        "PUBLIC_PADDLE_CLIENT_TOKEN": "paddle_sandbox_client_token_placeholder",
        // Preview must never serve real checkouts even if a Paddle sandbox
        // value were ever mistakenly wired in here — see
        // packages/config/src/env.ts's cross-field validation, which also
        // hard-rejects PADDLE_ENVIRONMENT=production outside production.
        "BILLING_ENABLED": "false",
        "AUDIT_ENGINE_ENABLED": "false",
      },
    },
  },
}
