---
/**
 * Homepage Section 5 — "Not every AI crawler serves the same purpose" (Phase 4 IA §12). Static
 * content using the current crawler-registry glossary terms (docs/brand/PRODUCT_TERMINOLOGY_GLOSSARY.md)
 * — no hydration needed.
 */
const PURPOSES = [
  {
    label: "Search",
    body: "Used to support search or discovery experiences, indexing content to help answer queries.",
  },
  {
    label: "Training",
    body: "Used to collect content for model development or training. A separate decision from search, often using a different crawler token.",
  },
  {
    label: "User-triggered retrieval",
    body: "Used when a person explicitly asks a product to retrieve a specific page in real time.",
  },
  {
    label: "Agents",
    body: "Used by automated or semi-automated agent workflows performing a task, distinct from a one-shot retrieval.",
  },
];
---

<section class="bg-neutral-50 py-16">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
    <h2 class="text-h2 text-neutral-950">Not every AI crawler serves the same purpose.</h2>
    <p class="mt-3 max-w-2xl text-body text-neutral-700">
      Crawler operators increasingly separate purposes into distinct tokens. Blocking one purpose
      does not automatically affect another, and classifications are reviewed against official
      documentation rather than assumed.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        PURPOSES.map((purpose) => (
          <div class="rounded-card border border-neutral-200 bg-white p-5">
            <h3 class="text-card-heading text-neutral-950">{purpose.label}</h3>
            <p class="mt-2 text-body text-neutral-700">{purpose.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-body text-neutral-700">
      Registry classifications may change when an operator updates its own documentation — see the{
        " "
      }
      <a href="/crawlers" class="text-brand-700 underline underline-offset-2"
        >AI crawler directory</a
      > for every verified entry and its source.
    </p>
  </div>
</section>
