---
/**
 * Homepage section (Phase 7: Vertical Landing Pages and Platform SEO Architecture) — surfaces the
 * four audience-specific landing pages and the platform hub, so both are reachable from the
 * homepage's own link graph (see docs/seo/INTERNAL_LINK_ARCHITECTURE.md's orphan-page prevention
 * rule). Sourced from the `verticals` content collection so this list can never drift from what's
 * actually published — adding or removing a vertical page automatically updates this section.
 */
import { getCollection } from "astro:content";

const VERTICAL_ORDER = ["agencies", "publishers", "saas-and-documentation", "web-developers"];
const allVerticals = await getCollection("verticals");
const verticals = VERTICAL_ORDER.map((id) => allVerticals.find((v) => v.id === id)).filter(
  (v) => v !== undefined,
);
---

<section class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
  <h2 class="text-h2 text-neutral-950">Built for how your team actually works</h2>
  <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
    The same audit and monitoring engine, with guidance shaped around what your role actually needs
    to know.
  </p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      verticals.map((vertical) => (
        <li class="rounded-card border border-neutral-200 bg-white p-5">
          <h3 class="text-card-heading text-neutral-950">
            <a href={`/for/${vertical.id}/`} class="hover:text-brand-700">
              {vertical.data.audience}
            </a>
          </h3>
          <p class="mt-2 text-supporting text-neutral-600">{vertical.data.primaryProblem}</p>
        </li>
      ))
    }
  </ul>
  <div class="mt-6">
    <a href="/platforms" class="text-body font-medium text-brand-700 underline underline-offset-2">
      See implementation guides by platform
    </a>
  </div>
</section>
