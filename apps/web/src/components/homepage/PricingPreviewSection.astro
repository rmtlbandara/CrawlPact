---
import type { Plan } from "../../lib/plans";

/**
 * Homepage Section 10 — pricing preview (Phase 4 IA §17). Reads from the same `PLANS` array as
 * `/pricing` (see `apps/web/src/lib/plans.ts`) — no duplicate hardcoded pricing. Deliberately
 * simpler than the full pricing page (name, audience, domain limit, monitoring, price, CTA only —
 * no feature-comparison table).
 */
export type Props = { plans: Plan[] };
const { plans } = Astro.props;
---

<section class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-h2 text-neutral-950">Pricing</h2>
    <a
      href="/pricing"
      data-analytics-event="homepage_pricing_clicked"
      class="text-body font-medium text-brand-700 hover:underline"
    >
      View full pricing
    </a>
  </div>
  <p class="mt-2 max-w-2xl text-body text-neutral-700">
    Annual pricing. Billing is handled by Paddle; applicable taxes may be calculated during
    checkout.
  </p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      plans.map((plan) => (
        <div
          class={`rounded-card border p-5 ${plan.recommended ? "border-brand-600 ring-1 ring-brand-600" : "border-neutral-200"}`}
        >
          {plan.recommended && (
            <p class="mb-2 text-metadata font-medium uppercase tracking-wide text-brand-700">
              Recommended
            </p>
          )}
          <h3 class="text-card-heading text-neutral-950">{plan.name}</h3>
          <p class="mt-1 text-supporting text-neutral-500">{plan.audience}</p>
          <p class="mt-2 text-h3 text-neutral-950">{plan.price}/yr</p>
          <p class="mt-2 text-supporting text-neutral-600">
            {plan.domains} domain{plan.domains === 1 ? "" : "s"}
          </p>
          <p class="text-supporting text-neutral-600">
            {plan.monitoring === "None" ? "No monitoring" : `${plan.monitoring} monitoring`}
          </p>
          <a
            href={`/pricing#${plan.id}`}
            class="mt-4 block rounded-control border border-neutral-300 px-3 py-2 text-center text-body font-medium text-neutral-800 hover:bg-neutral-50"
          >
            {plan.cta}
          </a>
        </div>
      ))
    }
  </div>
</section>
