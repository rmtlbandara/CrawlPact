---
import { SignOutButton } from "../auth/SignOutButton";
import { NotificationBadge } from "./NotificationBadge";
import { AppMobileNav } from "./AppMobileNav";
import BrandMark from "../BrandMark.astro";

export type Props = { displayName: string };
const { displayName } = Astro.props;

const links = [
  { label: "Overview", href: "/app" },
  { label: "Domains", href: "/app/domains" },
  { label: "Groups", href: "/app/groups" },
  { label: "Notifications", href: "/app/notifications" },
  { label: "Billing", href: "/app/billing" },
  { label: "Account", href: "/app/account" },
];

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  return href === "/app" ? currentPath === "/app" : currentPath.startsWith(href);
}
---

<header class="border-b border-neutral-200 bg-white">
  <div class="mx-auto flex max-w-[1100px] items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <div class="flex items-center gap-1">
      <a href="/" class="mr-4 flex items-center gap-2 text-body font-semibold text-neutral-950">
        <BrandMark class="size-7" />
        CrawlPact
      </a>
      {
        /* This project remaps Tailwind's breakpoint scale (packages/ui/src/tokens/tokens.css
          — md:640px, lg:768px, xl:1024px). Below `xl`, AppMobileNav takes over — confirmed
          via a real Playwright test that this link list has no room at 360/768px
          (516px of horizontal overflow) since it was previously always rendered. See
          docs/status/KNOWN_RISKS.md and apps/web/tests/e2e/responsive-smoke.spec.ts. */
      }
      <nav class="hidden items-center gap-1 xl:flex" aria-label="Dashboard navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`rounded-control px-3 py-2 text-body font-medium ${
                isActive(link.href)
                  ? "bg-brand-50 text-brand-700"
                  : "text-neutral-700 hover:bg-neutral-100"
              }`}
            >
              {link.label}
              {link.href === "/app/notifications" && <NotificationBadge client:load />}
            </a>
          ))
        }
      </nav>
      <AppMobileNav client:idle links={links} currentPath={currentPath} />
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden text-supporting text-neutral-600 sm:inline">{displayName}</span>
      <SignOutButton client:load />
    </div>
  </div>
</header>
