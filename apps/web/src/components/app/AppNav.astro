---
import { SignOutButton } from "../auth/SignOutButton";
import { NotificationBadge } from "./NotificationBadge";

export type Props = { displayName: string };
const { displayName } = Astro.props;

const links = [
  { label: "Overview", href: "/app" },
  { label: "Domains", href: "/app/domains" },
  { label: "Groups", href: "/app/groups" },
  { label: "Notifications", href: "/app/notifications" },
  { label: "Billing", href: "/app/billing" },
  { label: "Account", href: "/app/account" },
];

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  return href === "/app" ? currentPath === "/app" : currentPath.startsWith(href);
}
---

<header class="border-b border-neutral-200 bg-white">
  <div class="mx-auto flex max-w-[1100px] items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <nav class="flex items-center gap-1" aria-label="Dashboard navigation">
      <a href="/" class="mr-4 text-body font-semibold text-neutral-950"> CrawlPact </a>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={`rounded-control px-3 py-2 text-body font-medium ${
              isActive(link.href)
                ? "bg-brand-50 text-brand-700"
                : "text-neutral-700 hover:bg-neutral-100"
            }`}
          >
            {link.label}
            {link.href === "/app/notifications" && <NotificationBadge client:load />}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <span class="text-supporting text-neutral-600">{displayName}</span>
      <SignOutButton client:load />
    </div>
  </div>
</header>
