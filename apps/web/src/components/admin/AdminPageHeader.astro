---
// SRS §10.18 page header pattern, reused across every /admin/* page so the
// title/description/action layout stays consistent without copy-pasting it
// into two dozen Astro files.
export type Props = { title: string; description?: string; metadata?: string };
const { title, description, metadata } = Astro.props;
---

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-h1 text-neutral-950">{title}</h1>
    {description && <p class="mt-2 text-body text-neutral-700">{description}</p>}
    {metadata && <p class="mt-1 text-supporting text-neutral-500">{metadata}</p>}
  </div>
  <div class="flex items-center gap-2">
    <slot name="actions" />
  </div>
</div>
