---
import BrandMark from "./BrandMark.astro";
import { BRAND } from "../config/brand";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { label: "Domain audit", href: "/audit" },
      { label: "Pricing", href: "/pricing" },
      { label: "Crawler directory", href: "/crawlers" },
      { label: "Free tools", href: "/tools" },
      { label: "Changelog", href: "/changelog" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Guides", href: "/guides" },
      { label: "Methodology", href: "/methodology" },
      { label: "Scoring methodology", href: "/scoring" },
      { label: "Scanner information", href: "/scanner" },
    ],
  },
  {
    title: "Company and legal",
    links: [
      { label: "About CrawlPact", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy policy", href: "/privacy" },
      { label: "Terms of service", href: "/terms" },
      { label: "Acceptable use", href: "/acceptable-use" },
      { label: "Security", href: "/security" },
      { label: "Limitations", href: "/limitations" },
      { label: "Status", href: "/status" },
    ],
  },
];
---

<footer class="no-print border-t border-neutral-200 bg-white">
  <div
    class="mx-auto grid max-w-[1240px] gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.2fr_1fr_1fr_1fr]"
  >
    <div>
      <div class="flex items-center gap-2">
        <span
          aria-hidden="true"
          class="flex size-7 items-center justify-center rounded-control bg-brand-600 text-white"
        >
          <BrandMark class="size-4" />
        </span>
        <p class="text-h3 font-semibold text-neutral-950">{BRAND.productName}</p>
      </div>
      <p class="mt-2 max-w-xs text-supporting text-neutral-600">
        {BRAND.publicCategory}. Audit and monitor your website's declared AI crawler policy — vendor
        neutral, evidence based, no AI model required.
      </p>
      <p class="mt-4 text-metadata text-neutral-500">© {year} {BRAND.productName}</p>
    </div>
    {
      columns.map((column) => (
        <div>
          <p class="text-supporting font-medium text-neutral-500">{column.title}</p>
          <ul class="mt-3 flex flex-col gap-2">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-body text-neutral-700 hover:text-brand-700">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>
