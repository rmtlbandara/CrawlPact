---
import BaseLayout from "./BaseLayout.astro";
import AppNav from "../components/app/AppNav.astro";

export type Props = { title: string; displayName: string };
const { title, displayName } = Astro.props;
---

<BaseLayout
  title={`${title} | CrawlPact`}
  description="CrawlPact customer dashboard."
  noindex={true}
>
  <div class="flex min-h-screen flex-col bg-neutral-50">
    <AppNav displayName={displayName} />
    <main
      id="main-content"
      tabindex="-1"
      class="mx-auto w-full max-w-[1100px] flex-1 px-4 py-8 sm:px-6"
    >
      <slot />
    </main>
  </div>
</BaseLayout>
