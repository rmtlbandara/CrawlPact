---
import BaseLayout from "./BaseLayout.astro";
import type { Breadcrumb } from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

export type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedDate?: string;
  updatedDate?: string;
  breadcrumbs?: Breadcrumb[];
};

const {
  title,
  description,
  canonicalPath,
  noindex,
  ogType,
  publishedDate,
  updatedDate,
  breadcrumbs,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  ogType={ogType}
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main-content" tabindex="-1" class="flex-1">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="no-print mx-auto max-w-[1240px] px-4 pt-6 sm:px-6">
            <ol class="flex flex-wrap items-center gap-1.5 text-supporting text-neutral-500">
              {breadcrumbs.map((crumb, index) => (
                <li class="flex items-center gap-1.5">
                  {index > 0 && <span aria-hidden="true">/</span>}
                  {index === breadcrumbs.length - 1 ? (
                    <span aria-current="page" class="text-neutral-700">
                      {crumb.name}
                    </span>
                  ) : (
                    <a href={crumb.url} class="hover:text-brand-700">
                      {crumb.name}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
