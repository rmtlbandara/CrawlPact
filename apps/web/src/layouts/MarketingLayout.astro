---
import BaseLayout from "./BaseLayout.astro";
import type { Breadcrumb } from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { AnalyticsConsent } from "../components/AnalyticsConsent";
import { getEnv } from "../lib/env";
import {
  ANALYTICS_CONSENT_COOKIE,
  isGaEligibleRoute,
  parseConsentCookieValue,
} from "../lib/consent";

export type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedDate?: string;
  updatedDate?: string;
  breadcrumbs?: Breadcrumb[];
  extraJsonLd?: Record<string, unknown>[];
  ogImage?: string;
};

const {
  title,
  description,
  canonicalPath,
  noindex,
  ogType,
  publishedDate,
  updatedDate,
  breadcrumbs,
  extraJsonLd,
  ogImage,
} = Astro.props;

// Marketing-only, explicit SRS §6.2 deviation (see docs/status/KNOWN_RISKS.md).
// Gated to production so local/preview traffic never reaches Google Analytics.
const isProduction = getEnv().PUBLIC_APP_ENV === "production";
// Phase 13 (RISK-021): GA additionally requires granted, current-version
// consent AND this exact route to be on the allowlist — see
// apps/web/src/lib/consent.ts and docs/analytics/GOOGLE_ANALYTICS_SCOPE_POLICY.md.
const gaEligible = isGaEligibleRoute(Astro.url.pathname);
const consentState = parseConsentCookieValue(Astro.cookies.get(ANALYTICS_CONSENT_COOKIE)?.value);
const shouldRenderGa = isProduction && gaEligible && consentState === "granted";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  ogType={ogType}
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  extraJsonLd={extraJsonLd}
  ogImage={ogImage}
>
  {shouldRenderGa && <GoogleAnalytics />}
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main-content" tabindex="-1" class="flex-1">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="no-print mx-auto max-w-[1240px] px-4 pt-6 sm:px-6">
            <ol class="flex flex-wrap items-center gap-1.5 text-supporting text-neutral-500">
              {breadcrumbs.map((crumb, index) => (
                <li class="flex items-center gap-1.5">
                  {index > 0 && <span aria-hidden="true">/</span>}
                  {index === breadcrumbs.length - 1 ? (
                    <span aria-current="page" class="text-neutral-700">
                      {crumb.name}
                    </span>
                  ) : (
                    <a href={crumb.url} class="hover:text-brand-700">
                      {crumb.name}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <SiteFooter />
  </div>
  {isProduction && <AnalyticsConsent client:load gaEligible={gaEligible} />}
</BaseLayout>
