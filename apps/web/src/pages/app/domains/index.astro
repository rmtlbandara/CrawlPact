---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import { DomainsManager } from "../../../components/app/DomainsManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getPageSession } from "../../../lib/auth/page-session";
import { getPlan } from "../../../lib/plan";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;

const plan = await getPlan(db, user.planId);
---

<AppLayout title="Domains" displayName={user.displayName}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-h1 text-neutral-950">Domains</h1>
      <p class="mt-2 text-body text-neutral-700">
        Save a domain to track its AI crawler policy over time and schedule regular re-checks.
      </p>
    </div>
    {
      plan.csvExportEnabled && (
        <a
          href="/api/domains/export.csv"
          class="inline-block rounded-control border border-neutral-300 bg-white px-4 py-2 text-body font-medium text-neutral-800 hover:bg-neutral-50"
        >
          Export CSV
        </a>
      )
    }
  </div>
  <div class="mt-6">
    <DomainsManager client:load batchImportLimit={plan.batchImportLimit} />
  </div>
</AppLayout>
