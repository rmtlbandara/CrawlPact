---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import { DomainDetailActions } from "../../../components/app/DomainDetailActions";
import { ScoreComponent, ErrorState, StatusChip } from "@crawlpact/ui";
import { scoreLabelFor } from "@crawlpact/policy";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getPageSession } from "../../../lib/auth/page-session";
import { getOwnedDomain, listScansForDomain } from "../../../lib/domains";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;

const { domainId } = Astro.params;
const domain = domainId ? await getOwnedDomain(db, user.id, domainId) : null;
const scans = domain ? await listScansForDomain(db, domain.id) : [];
---

<AppLayout title={domain ? domain.displayName : "Domain"} displayName={user.displayName}>
  {
    !domain ? (
      <ErrorState
        title="Domain not found"
        description="This domain doesn't exist or isn't saved to your account."
      />
    ) : (
      <>
        <a href="/app/domains" class="text-supporting font-medium text-brand-700">
          ← All domains
        </a>
        <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-h1 text-neutral-950">{domain.displayName}</h1>
            <p class="text-body text-neutral-600">{domain.canonicalOrigin}</p>
          </div>
          {domain.lastScanId && (
            <a
              href={`/audit/${domain.lastScanId}`}
              class="inline-block rounded-control border border-neutral-300 bg-white px-4 py-2 text-body font-medium text-neutral-800 hover:bg-neutral-50"
            >
              View latest report
            </a>
          )}
        </div>

        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
          <div class="flex flex-col gap-6">
            <div class="rounded-card border border-neutral-200 bg-white p-5">
              <h2 class="text-card-heading text-neutral-950">Policy Health Score</h2>
              <div class="mt-3">
                <ScoreComponent
                  score={
                    domain.currentScore === null
                      ? { state: "incomplete" }
                      : {
                          state: "scored",
                          value: domain.currentScore,
                          label: scoreLabelFor(domain.currentScore),
                        }
                  }
                />
              </div>
            </div>

            <div class="rounded-card border border-neutral-200 bg-white p-5">
              <h2 class="text-card-heading text-neutral-950">Scan history</h2>
              {scans.length === 0 ? (
                <p class="mt-2 text-body text-neutral-600">No scans yet for this domain.</p>
              ) : (
                <ul class="mt-3 divide-y divide-neutral-200">
                  {scans.map((scan) => (
                    <li class="flex items-center justify-between gap-3 py-2">
                      <a href={`/audit/${scan.scanId}`} class="text-body text-brand-700">
                        {new Date(scan.startedAt).toLocaleString()}
                      </a>
                      <div class="flex items-center gap-2">
                        <span class="text-supporting text-neutral-600">{scan.triggeredBy}</span>
                        <StatusChip
                          tone={scan.status.startsWith("completed") ? "success" : "warning"}
                          label={scan.status}
                        />
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <DomainDetailActions
            client:load
            domainId={domain.id}
            preset={domain.preset}
            monitoringState={domain.monitoringState}
            notes={domain.notes}
          />
        </div>
      </>
    )
  }
</AppLayout>
