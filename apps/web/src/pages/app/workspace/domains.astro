---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import { PortfolioTable } from "../../../components/app/PortfolioTable";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getPageSession } from "../../../lib/auth/page-session";
import { getPlan } from "../../../lib/plan";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;
const plan = await getPlan(db, user.planId);
---

<AppLayout title="Managed domains" displayName={user.displayName}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-h1 text-neutral-950">Managed domains</h1>
      <p class="mt-2 text-body text-neutral-700">Your full portfolio, filterable and sortable.</p>
    </div>
    <a href="/app/workspace" class="text-supporting text-brand-700 underline">Back to workspace</a>
  </div>
  <div class="mt-6">
    <PortfolioTable client:load domainGroupsEnabled={plan.domainGroupsEnabled} />
  </div>
</AppLayout>
