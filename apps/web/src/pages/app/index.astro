---
export const prerender = false;
import AppLayout from "../../layouts/AppLayout.astro";
import { MetricCard, EmptyState, StatusChip } from "@crawlpact/ui";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../lib/env";
import { getPageSession } from "../../lib/auth/page-session";
import { listDomains } from "../../lib/domains";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;

const domains = await listDomains(db, user.id);
const scoredDomains = domains.filter((d) => d.currentScore !== null);
const averageScore =
  scoredDomains.length > 0
    ? Math.round(
        scoredDomains.reduce((sum, d) => sum + (d.currentScore ?? 0), 0) / scoredDomains.length,
      )
    : null;
const needsAttention = [...domains]
  .filter((d) => d.openFindingsCount > 0 || (d.currentScore !== null && d.currentScore < 75))
  .sort((a, b) => b.openFindingsCount - a.openFindingsCount)
  .slice(0, 5);
const nextScan = domains
  .filter((d) => d.nextScanAt)
  .sort((a, b) => new Date(a.nextScanAt!).getTime() - new Date(b.nextScanAt!).getTime())[0];
---

<AppLayout title="Overview" displayName={user.displayName}>
  <h1 class="text-h1 text-neutral-950">Overview</h1>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <MetricCard label="Saved domains" value={domains.length} />
    <MetricCard
      label="Average Policy Health Score"
      value={averageScore === null ? "—" : averageScore}
      helpText={averageScore === null ? "No scored domains yet" : undefined}
    />
    <MetricCard
      label="Next scheduled scan"
      value={nextScan?.nextScanAt ? new Date(nextScan.nextScanAt).toLocaleDateString() : "—"}
      helpText={!nextScan ? "No domain is on a monitoring schedule yet" : undefined}
    />
  </div>

  <section class="mt-10">
    <h2 class="text-h2 text-neutral-950">Needs attention</h2>
    {
      needsAttention.length === 0 ? (
        <div class="mt-4">
          <EmptyState
            title="Nothing needs attention right now"
            description="Domains with open findings or a low Policy Health Score will show up here."
          />
        </div>
      ) : (
        <ul class="mt-4 divide-y divide-neutral-200 rounded-card border border-neutral-200 bg-white">
          {needsAttention.map((domain) => (
            <li class="flex items-center justify-between gap-4 px-4 py-3">
              <div>
                <a
                  href={`/app/domains/${domain.domainId}`}
                  class="text-body font-medium text-brand-700"
                >
                  {domain.displayName}
                </a>
                <p class="text-supporting text-neutral-600">{domain.canonicalOrigin}</p>
              </div>
              <div class="flex items-center gap-3">
                {domain.openFindingsCount > 0 && (
                  <StatusChip
                    tone="warning"
                    label={`${domain.openFindingsCount} finding${domain.openFindingsCount === 1 ? "" : "s"}`}
                  />
                )}
                <span class="text-body font-medium text-neutral-900">
                  {domain.currentScore ?? "—"}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    domains.length === 0 && (
      <div class="mt-10 flex flex-col items-center gap-3 rounded-card border border-dashed border-neutral-300 px-6 py-12 text-center">
        <h3 class="text-h3 text-neutral-900">No saved domains yet</h3>
        <p class="max-w-sm text-body text-neutral-600">
          Save a domain to start monitoring its AI crawler policy.
        </p>
        <a
          href="/app/domains"
          class="inline-block rounded-control bg-brand-600 px-5 py-3 text-body font-medium text-white hover:bg-brand-700"
        >
          Add your first domain
        </a>
      </div>
    )
  }
</AppLayout>
