---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import { Alert, StatusChip } from "@crawlpact/ui";
import { BillingPlansSection } from "../../../components/app/BillingPlansSection";
import { PortalButton } from "../../../components/app/PortalButton";
import { createDb, schema } from "@crawlpact/database";
import { eq } from "drizzle-orm";
import { getEnv } from "../../../lib/env";
import { getPageSession } from "../../../lib/auth/page-session";
import { getPlan } from "../../../lib/plan";
import { countActiveDomains } from "../../../lib/domains";
import { getPlanCatalog } from "../../../lib/billing/plan-catalog";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;

const plan = await getPlan(db, user.planId);
const domainCount = await countActiveDomains(db, user.id);

const [billingCustomer] = await db
  .select()
  .from(schema.billingCustomers)
  .where(eq(schema.billingCustomers.userId, user.id))
  .limit(1);

const subscription = billingCustomer
  ? (
      await db
        .select()
        .from(schema.subscriptions)
        .where(eq(schema.subscriptions.billingCustomerId, billingCustomer.id))
        .limit(1)
    )[0]
  : undefined;

const PLAN_LABELS: Record<string, string> = {
  free: "Free",
  solo: "Solo",
  pro: "Pro",
  agency: "Agency",
};

const hasActiveSubscription =
  subscription !== undefined &&
  ["active", "trialing", "past_due"].includes(subscription.status) &&
  subscription.billingInterval !== null &&
  subscription.planId !== "free";

// Phase 6 checkout continuity: /pricing's CTAs carry `?plan=&interval=` through sign-in to here
// (see sign-in.astro). Display/UI-hint only — never trusted for price resolution, which every
// checkout/plan-change endpoint re-validates server-side regardless of this query param.
const requestedInterval = Astro.url.searchParams.get("interval");
const initialInterval =
  requestedInterval === "month" || requestedInterval === "year" ? requestedInterval : undefined;

const env = getEnv();
const catalog = await getPlanCatalog(db, env.PADDLE_ENVIRONMENT);
const paidPlans = catalog
  .filter((entry) => entry.pricing !== null)
  .map((entry) => ({
    id: entry.id as "solo" | "pro" | "agency",
    name: entry.name,
    monthlyCents: entry.pricing!.month.amountUsdCents,
    yearlyCents: entry.pricing!.year.amountUsdCents,
  }));
---

<AppLayout title="Billing" displayName={user.displayName}>
  <h1 class="text-h1 text-neutral-950">Billing</h1>

  <div class="mt-6 rounded-card border border-neutral-200 bg-white p-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-supporting font-medium text-neutral-600">Current plan</p>
        <p class="text-h2 text-neutral-950">{PLAN_LABELS[plan.id] ?? plan.id}</p>
      </div>
      {
        subscription && (
          <StatusChip
            tone={
              subscription.status === "active"
                ? "success"
                : subscription.status === "past_due"
                  ? "warning"
                  : "unknown"
            }
            label={subscription.status.replace(/_/g, " ")}
          />
        )
      }
    </div>

    {
      subscription?.status === "past_due" && (
        <div class="mt-4">
          <Alert tone="warning" title="Payment past due">
            Paddle is retrying your payment. Your plan stays active during this grace period —
            update your payment method to avoid interruption.
          </Alert>
        </div>
      )
    }
    {
      subscription?.cancelAtPeriodEnd && (
        <div class="mt-4">
          <Alert tone="info" title="Subscription scheduled to cancel">
            {subscription.currentPeriodEnd
              ? `Your plan reverts to Free after ${new Date(subscription.currentPeriodEnd).toLocaleDateString()}.`
              : "Your plan will revert to Free at the end of the current billing period."}
          </Alert>
        </div>
      )
    }
    {
      subscription?.scheduledPlanId && (
        <div class="mt-4">
          <Alert tone="info" title="Plan change scheduled">
            {`Your plan changes to ${PLAN_LABELS[subscription.scheduledPlanId] ?? subscription.scheduledPlanId}${
              subscription.scheduledChangeEffectiveAt
                ? ` on ${new Date(subscription.scheduledChangeEffectiveAt).toLocaleDateString()}`
                : " at the end of the current billing period"
            }. You keep your current plan until then.`}
          </Alert>
        </div>
      )
    }

    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-supporting text-neutral-600">Domain usage</dt>
        <dd class="text-body text-neutral-900">
          {domainCount} / {plan.savedDomainLimit} saved domains
        </dd>
      </div>
      <div>
        <dt class="text-supporting text-neutral-600">Monitoring frequency</dt>
        <dd class="text-body text-neutral-900">{plan.monitoringFrequency}</dd>
      </div>
      {
        subscription?.currentPeriodEnd && (
          <div>
            <dt class="text-supporting text-neutral-600">Renews</dt>
            <dd class="text-body text-neutral-900">
              {new Date(subscription.currentPeriodEnd).toLocaleDateString()}
            </dd>
          </div>
        )
      }
    </dl>

    {
      billingCustomer && (
        <div class="mt-4">
          <PortalButton client:load />
        </div>
      )
    }
  </div>

  <section class="mt-8">
    <h2 class="text-h2 text-neutral-950">Plans</h2>
    <p class="mt-2 text-body text-neutral-700">
      All prices are in USD. Applicable taxes may be calculated during Paddle checkout.{" "}
      {
        billingCustomer
          ? "You can cancel any time through the billing portal above."
          : "Once subscribed, you can manage or cancel your plan any time from this page."
      }
    </p>
    <div class="mt-4">
      <BillingPlansSection
        client:load
        plans={paidPlans}
        currentPlanId={hasActiveSubscription
          ? (subscription!.planId as "solo" | "pro" | "agency")
          : null}
        currentInterval={hasActiveSubscription ? subscription!.billingInterval : null}
        initialInterval={initialInterval}
      />
    </div>
  </section>
</AppLayout>
