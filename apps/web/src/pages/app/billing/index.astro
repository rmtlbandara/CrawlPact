---
export const prerender = false;
import AppLayout from "../../../layouts/AppLayout.astro";
import { Alert, StatusChip } from "@crawlpact/ui";
import { CheckoutButton } from "../../../components/app/CheckoutButton";
import { PortalButton } from "../../../components/app/PortalButton";
import { createDb, schema } from "@crawlpact/database";
import { eq } from "drizzle-orm";
import { getEnv } from "../../../lib/env";
import { getPageSession } from "../../../lib/auth/page-session";
import { getPlan } from "../../../lib/plan";
import { countActiveDomains } from "../../../lib/domains";

const db = createDb(getEnv().DB);
const result = await getPageSession(db, Astro.request);
if (!result) return Astro.redirect("/sign-in");
const { user } = result;

const plan = await getPlan(db, user.planId);
const domainCount = await countActiveDomains(db, user.id);

const [billingCustomer] = await db
  .select()
  .from(schema.billingCustomers)
  .where(eq(schema.billingCustomers.userId, user.id))
  .limit(1);

const subscription = billingCustomer
  ? (
      await db
        .select()
        .from(schema.subscriptions)
        .where(eq(schema.subscriptions.billingCustomerId, billingCustomer.id))
        .limit(1)
    )[0]
  : undefined;

const PLAN_LABELS: Record<string, string> = {
  free: "Free",
  solo: "Solo",
  pro: "Pro",
  agency: "Agency",
};
const PAID_PLANS = [
  { id: "solo" as const, label: "Solo" },
  { id: "pro" as const, label: "Pro" },
  { id: "agency" as const, label: "Agency" },
];
---

<AppLayout title="Billing" displayName={user.displayName}>
  <h1 class="text-h1 text-neutral-950">Billing</h1>

  <div class="mt-6 rounded-card border border-neutral-200 bg-white p-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-supporting font-medium text-neutral-600">Current plan</p>
        <p class="text-h2 text-neutral-950">{PLAN_LABELS[plan.id] ?? plan.id}</p>
      </div>
      {
        subscription && (
          <StatusChip
            tone={
              subscription.status === "active"
                ? "success"
                : subscription.status === "past_due"
                  ? "warning"
                  : "unknown"
            }
            label={subscription.status.replace(/_/g, " ")}
          />
        )
      }
    </div>

    {
      subscription?.status === "past_due" && (
        <div class="mt-4">
          <Alert tone="warning" title="Payment past due">
            Paddle is retrying your payment. Your plan stays active during this grace period —
            update your payment method to avoid interruption.
          </Alert>
        </div>
      )
    }
    {
      subscription?.cancelAtPeriodEnd && (
        <div class="mt-4">
          <Alert tone="info" title="Subscription scheduled to cancel">
            {subscription.currentPeriodEnd
              ? `Your plan reverts to Free after ${new Date(subscription.currentPeriodEnd).toLocaleDateString()}.`
              : "Your plan will revert to Free at the end of the current billing period."}
          </Alert>
        </div>
      )
    }

    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-supporting text-neutral-600">Domain usage</dt>
        <dd class="text-body text-neutral-900">
          {domainCount} / {plan.savedDomainLimit} saved domains
        </dd>
      </div>
      <div>
        <dt class="text-supporting text-neutral-600">Monitoring frequency</dt>
        <dd class="text-body text-neutral-900">{plan.monitoringFrequency}</dd>
      </div>
      {
        subscription?.currentPeriodEnd && (
          <div>
            <dt class="text-supporting text-neutral-600">Renews</dt>
            <dd class="text-body text-neutral-900">
              {new Date(subscription.currentPeriodEnd).toLocaleDateString()}
            </dd>
          </div>
        )
      }
    </dl>

    {
      billingCustomer && (
        <div class="mt-4">
          <PortalButton client:load />
        </div>
      )
    }
  </div>

  <section class="mt-8">
    <h2 class="text-h2 text-neutral-950">Plans</h2>
    <p class="mt-2 text-body text-neutral-700">
      Prices and taxes are handled by Paddle at checkout. You can cancel any time through the
      billing portal above.
    </p>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        PAID_PLANS.map((paidPlan) => (
          <div class="rounded-card border border-neutral-200 bg-white p-5">
            <h3 class="text-card-heading text-neutral-950">{paidPlan.label}</h3>
            {plan.id === paidPlan.id ? (
              <p class="mt-3 text-supporting text-neutral-600">This is your current plan.</p>
            ) : (
              <div class="mt-3">
                <CheckoutButton
                  client:load
                  planId={paidPlan.id}
                  label={`Upgrade to ${paidPlan.label}`}
                />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>
</AppLayout>
