---
export const prerender = true;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../components/AnalyticsBeacon";

const plans = [
  {
    id: "free",
    name: "Free",
    audience: "For a one-time check on a single site.",
    price: "USD 0",
    domains: 1,
    monitoring: "None",
    history: "30 days",
    rescans: 2,
    groups: false,
    csv: false,
    feed: false,
    batch: 0,
    branding: false,
    cta: "Start free",
    recommended: false,
  },
  {
    id: "solo",
    name: "Solo",
    audience: "For individual site owners tracking one project.",
    price: "USD 79",
    domains: 5,
    monitoring: "Monthly",
    history: "12 months",
    rescans: 5,
    groups: false,
    csv: false,
    feed: true,
    batch: 0,
    branding: false,
    cta: "Choose Solo",
    recommended: false,
  },
  {
    id: "pro",
    name: "Pro",
    audience: "For growing portfolios that need weekly monitoring.",
    price: "USD 179",
    domains: 25,
    monitoring: "Weekly",
    history: "24 months",
    rescans: 10,
    groups: true,
    csv: true,
    feed: true,
    batch: 10,
    branding: false,
    cta: "Choose Pro",
    recommended: true,
  },
  {
    id: "agency",
    name: "Agency",
    audience: "For agencies managing many client domains.",
    price: "USD 399",
    domains: 100,
    monitoring: "Weekly",
    history: "36 months",
    rescans: 20,
    groups: true,
    csv: true,
    feed: true,
    batch: 100,
    branding: true,
    cta: "Choose Agency",
    recommended: false,
  },
];

const webApplicationJsonLd = {
  "@type": "WebApplication",
  name: "CrawlPact",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: plans.map((plan) => {
    const [, priceAmount] = plan.price.split(" ");
    return {
      "@type": "Offer",
      name: `${plan.name} plan`,
      price: priceAmount,
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        billingDuration: "P1Y",
      },
    };
  }),
};
---

<MarketingLayout
  title="Pricing | CrawlPact"
  description="Annual pricing for CrawlPact's AI crawler policy auditing and monitoring plans, from a free single-domain audit to agency-scale portfolio monitoring."
  extraJsonLd={[webApplicationJsonLd]}
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Pricing</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      Annual billing, handled by Paddle as merchant of record. Applicable taxes may be calculated
      during checkout. Plan definitions are stored as product data, not hard-coded — see <a
        href="/status"
        class="text-brand-700 underline underline-offset-2">status</a
      >{" "}
      for current plan availability.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        plans.map((plan) => (
          <div
            class={`rounded-card border p-5 ${plan.recommended ? "border-brand-600 ring-1 ring-brand-600" : "border-neutral-200"}`}
          >
            {plan.recommended && (
              <p class="mb-2 text-metadata font-medium uppercase tracking-wide text-brand-700">
                Recommended
              </p>
            )}
            <h2 class="text-card-heading text-neutral-950">{plan.name}</h2>
            <p class="mt-1 text-supporting text-neutral-600">{plan.audience}</p>
            <p class="mt-2 text-h3 text-neutral-950">{plan.price}/yr</p>
            <p class="mt-2 text-supporting text-neutral-600">
              {plan.domains} domain{plan.domains === 1 ? "" : "s"}
            </p>
            <p class="text-supporting text-neutral-600">
              {plan.monitoring === "None" ? "No monitoring" : `${plan.monitoring} monitoring`}
            </p>
            <a
              href="/sign-in"
              class="mt-4 block rounded-control border border-neutral-300 px-3 py-2 text-center text-body font-medium text-neutral-800 hover:bg-neutral-50"
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label="Plan comparison table"
    >
      <table class="w-full min-w-[720px] border-collapse text-left text-body">
        <thead>
          <tr class="border-b border-neutral-200 text-supporting font-medium text-neutral-600">
            <th scope="col" class="py-3">Feature</th>
            {
              plans.map((plan) => (
                <th scope="col" class="py-3 text-neutral-950">
                  {plan.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Annual price</th>{
              plans.map((p) => <td class="py-3 font-medium">{p.price}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Saved domains</th>{
              plans.map((p) => <td class="py-3">{p.domains}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Monitoring</th>{
              plans.map((p) => <td class="py-3">{p.monitoring}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">History retention</th>{
              plans.map((p) => <td class="py-3">{p.history}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600"
              >Manual rescans / domain / month</th
            >{plans.map((p) => <td class="py-3">{p.rescans}</td>)}</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Domain groups</th>{
              plans.map((p) => <td class="py-3">{p.groups ? "Yes" : "No"}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">CSV export</th>{
              plans.map((p) => <td class="py-3">{p.csv ? "Yes" : "No"}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Private Atom feed</th>{
              plans.map((p) => <td class="py-3">{p.feed ? "Yes" : "No"}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Batch import</th>{
              plans.map((p) => <td class="py-3">{p.batch > 0 ? `Up to ${p.batch}` : "No"}</td>)
            }</tr
          >
          <tr
            ><th scope="row" class="py-3 font-normal text-neutral-600">Agency branding</th>{
              plans.map((p) => <td class="py-3">{p.branding ? "Yes" : "No"}</td>)
            }</tr
          >
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-body text-neutral-700">
      <a href="/sign-in" class="text-brand-700 underline underline-offset-2">Create an account</a>{
        " "
      }
      to upgrade — checkout runs through Paddle from your dashboard's billing page. Paddle handles payment,
      tax, and receipts; CrawlPact never sees your card details.
    </p>
    <p class="mt-2 text-supporting text-neutral-500">
      This deployment is still in active development — see <a
        href="/status"
        class="text-brand-700 underline underline-offset-2">status</a
      > for what's verified so far.
    </p>
  </div>
  <AnalyticsBeacon client:load eventName="pricing_viewed" />
</MarketingLayout>
