---
export const prerender = false;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../components/AnalyticsBeacon";
import { PricingPlans } from "../components/PricingPlans";
import type { PricingPlanEntry } from "../components/PricingPlans";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../lib/env";
import { getPageSession } from "../lib/auth/page-session";
import { getPlanCatalog } from "../lib/billing/plan-catalog";

const db = createDb(getEnv().DB);
const env = getEnv();
const session = await getPageSession(db, Astro.request);
const catalog = await getPlanCatalog(db, env.PADDLE_ENVIRONMENT);

const plans: PricingPlanEntry[] = catalog.map((entry) => ({
  id: entry.id,
  name: entry.name,
  audience: entry.audience,
  cta: entry.cta,
  recommended: entry.recommended,
  savedDomainLimit: entry.savedDomainLimit,
  monitoringFrequency: entry.monitoringFrequency,
  historyRetentionMonths: Math.round(entry.historyRetentionDays / 30),
  manualRescansPerDomainPerMonth: entry.manualRescansPerDomainPerMonth,
  domainGroupsEnabled: entry.domainGroupsEnabled,
  csvExportEnabled: entry.csvExportEnabled,
  privateAtomFeedEnabled: entry.privateAtomFeedEnabled,
  batchImportLimit: entry.batchImportLimit,
  agencyBrandingEnabled: entry.agencyBrandingEnabled,
  monthlyCents: entry.pricing?.month.amountUsdCents ?? null,
  yearlyCents: entry.pricing?.year.amountUsdCents ?? null,
}));

// Structured data lists every real offer (monthly and yearly for each paid plan) regardless of
// which interval the client-side toggle currently shows — see docs/billing/APPROVED_PRICING_AND_ENTITLEMENT_MATRIX.md.
const offers = plans.flatMap((plan) => {
  if (plan.id === "free") {
    return [
      {
        "@type": "Offer",
        name: "Free plan",
        price: "0",
        priceCurrency: "USD",
      },
    ];
  }
  return [
    {
      "@type": "Offer",
      name: `${plan.name} plan (monthly)`,
      price: (plan.monthlyCents! / 100).toFixed(2),
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", billingDuration: "P1M" },
    },
    {
      "@type": "Offer",
      name: `${plan.name} plan (yearly)`,
      price: (plan.yearlyCents! / 100).toFixed(2),
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", billingDuration: "P1Y" },
    },
  ];
});

const webApplicationJsonLd = {
  "@type": "WebApplication",
  name: "CrawlPact",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers,
};
---

<MarketingLayout
  title="Pricing | CrawlPact"
  description="Monthly and yearly pricing for CrawlPact's AI crawler policy auditing and monitoring plans, from a free single-domain audit to agency-scale portfolio monitoring."
  extraJsonLd={[webApplicationJsonLd]}
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Pricing</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      Choose a plan based on the number of domains you need to audit and monitor. Upgrade or cancel
      through your account at any time. All prices are in USD. Applicable taxes may be calculated
      during Paddle checkout.
    </p>

    <div class="mt-8">
      <PricingPlans client:load plans={plans} isAuthenticated={session !== null} />
    </div>

    <p class="mt-6 text-body text-neutral-700">
      {
        session ? (
          <>Manage your plan any time from your account's billing page.</>
        ) : (
          <>
            <a href="/sign-in" class="text-brand-700 underline underline-offset-2">
              Create an account
            </a>{" "}
            to subscribe — checkout runs through Paddle. Paddle handles payment, tax, and receipts;
            CrawlPact never sees your card details.
          </>
        )
      }
    </p>
  </div>
  <AnalyticsBeacon client:load eventName="pricing_viewed" />
</MarketingLayout>
