---
export const prerender = true;
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Acceptable Use Policy | CrawlPact"
  description="Rules for what may be audited with CrawlPact and how the scanner may be used."
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Acceptable use</h1>
    <p class="mt-3 text-supporting text-neutral-500">Draft — not yet reviewed by a lawyer.</p>

    <h2 class="mt-8 text-h2 text-neutral-950">Permitted use</h2>
    <p class="mt-3 text-body text-neutral-700">
      Use CrawlPact to audit and monitor the declared AI crawler policy of public websites you own,
      manage, or are otherwise authorised to evaluate.
    </p>

    <h2 class="mt-8 text-h2 text-neutral-950">Prohibited use</h2>
    <ul class="mt-3 list-disc pl-5 text-body text-neutral-700">
      <li>
        Submitting a target for the purpose of overloading, disrupting, or probing internal
        infrastructure.
      </li>
      <li>
        Attempting to bypass CrawlPact's target-safety validation (e.g. private-address or
        redirect-based access attempts).
      </li>
      <li>Automating high-volume submissions beyond documented rate limits.</li>
      <li>
        Using CrawlPact's scanner output to make claims of "compliance," "legal protection," or a
        guarantee of crawler behaviour.
      </li>
    </ul>

    <h2 class="mt-8 text-h2 text-neutral-950">Enforcement</h2>
    <p class="mt-3 text-body text-neutral-700">
      CrawlPact may rate-limit, suspend, or block accounts or targets associated with abusive or
      unsafe scan attempts, consistent with the security controls described on the{" "}
      <a href="/security" class="text-brand-700 underline underline-offset-2">security</a> page.
    </p>
  </article>
</MarketingLayout>
