---
export const prerender = true;
import { getCollection } from "astro:content";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { AuditForm } from "../components/AuditForm";
import { AnalyticsBeacon } from "../components/AnalyticsBeacon";
import RiskSection from "../components/homepage/RiskSection.astro";
import SampleReportSection from "../components/homepage/SampleReportSection.astro";
import CrawlerPurposeSection from "../components/homepage/CrawlerPurposeSection.astro";
import VerticalsSection from "../components/homepage/VerticalsSection.astro";
import AgencySection from "../components/homepage/AgencySection.astro";
import PricingPreviewSection from "../components/homepage/PricingPreviewSection.astro";
import { Accordion } from "@crawlpact/ui";
import { CRAWLER_PURPOSE_LABELS } from "@crawlpact/registry";
import { BRAND } from "../config/brand";

const crawlerPreview = (await getCollection("crawlers")).slice(0, 4);

const faqItems = [
  {
    value: "block-ai",
    title: "Does CrawlPact block AI crawlers?",
    content:
      "No. CrawlPact audits public policy signals and explains what they mean. Enforcement requires the website, CDN, WAF, hosting platform, or another control layer — CrawlPact never modifies your website.",
  },
  {
    value: "guarantee-obedience",
    title: "Does robots.txt guarantee crawler compliance?",
    content:
      "No. It publishes instructions that compliant crawlers may follow, but CrawlPact does not guarantee external crawler behaviour — see /limitations.",
  },
  {
    value: "search-vs-training",
    title: "What is the difference between AI search and training?",
    content:
      "Search crawlers may support discovery or answer retrieval, while training crawlers may support model development. Each operator and purpose must be evaluated individually — many operators use separate crawler tokens for each.",
  },
  {
    value: "unspecified",
    title: 'What does "unspecified" mean?',
    content:
      "It means CrawlPact did not detect an explicit applicable rule in the checked public signals. It is not automatically the same as explicit permission.",
  },
  {
    value: "server-logs",
    title: "Does CrawlPact need server-log access?",
    content:
      "No, for public policy auditing. Without traffic logs, CrawlPact does not prove whether a crawler actually visited or obeyed the policy.",
  },
  {
    value: "hosting-independence",
    title: "Does CrawlPact work outside Cloudflare?",
    content:
      "CrawlPact audits publicly accessible policy signals and is designed to work independently of a specific hosting provider. Actual support depends on the public resources being reachable.",
  },
  {
    value: "monitor-after-fix",
    title: "Why monitor after fixing the policy once?",
    content:
      "Website deployments, CDN settings, public resources, and crawler-registry knowledge can all change after your initial audit — see the monitoring section above.",
  },
  {
    value: "llms-txt-required",
    title: "Is llms.txt required?",
    content:
      "No. llms.txt is an independent community proposal, not an IETF or W3C standard — no AI system is known to require or guarantee use of it. CrawlPact checks it when publicly available and evaluates it according to the current published methodology.",
  },
  {
    value: "legal-advice",
    title: "Is CrawlPact legal advice or compliance certification?",
    content:
      "No. CrawlPact is a technical auditing and monitoring tool, not a legal or compliance service.",
  },
  {
    value: "monitoring",
    title: "How do paid monitoring and notifications work?",
    content:
      "Paid plans schedule recurring scans (monthly or weekly, by plan) and surface changes through an in-app notification centre and a private Atom feed — CrawlPact does not send email or SMS.",
  },
];
---

<MarketingLayout
  title={`AI Crawler Policy Auditor & Robots.txt Checker | ${BRAND.productName}`}
  description={BRAND.descriptions.short}
>
  <!-- Section 1 — Outcome-led hero -->
  <section id="hero-audit-form" class="mx-auto max-w-[1240px] px-4 py-14 sm:px-6 sm:py-20">
    <div class="flex items-center justify-between gap-12">
      <div class="max-w-3xl">
        <h1 class="text-h1 sm:text-display text-neutral-950">
          Audit and monitor your website's AI crawler policy.
        </h1>
        <p class="mt-4 text-body-lg text-neutral-700">
          CrawlPact independently audits robots.txt and related public signals, separates search
          from training and agent crawlers, explains conflicts, and monitors changes across any
          hosting provider.
        </p>
        <div class="mt-8">
          <AuditForm client:load idPrefix="hero" />
          <p class="mt-3 text-supporting text-neutral-600">
            No installation, server-log access, or AI API required. Try{" "}
            <code class="rounded-[4px] bg-neutral-100 px-1.5 py-0.5 font-mono text-supporting"
              >example.com</code
            >.
          </p>
        </div>
        <ul
          class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-supporting font-medium text-neutral-600"
        >
          <li>Vendor-neutral</li>
          <li>Evidence-based findings</li>
          <li>Works with any hosting provider</li>
          <li>Deterministic recommendations</li>
        </ul>
      </div>
      <img
        src="/branding/artwork1.png"
        alt=""
        aria-hidden="true"
        class="hidden w-[380px] shrink-0 xl:block"
      />
    </div>
  </section>

  <!-- Section 2 — Three crawler-policy risks -->
  <RiskSection />

  <!-- Section 3 — Sample report preview -->
  <SampleReportSection />

  <!-- Section 4 — How CrawlPact works -->
  <section class="bg-neutral-50 py-16">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
      <h2 class="text-h2 text-neutral-950">How CrawlPact works</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              step: "1",
              title: "Audit public policy signals",
              body: "CrawlPact requests publicly accessible resources such as robots.txt and related policy signals.",
            },
            {
              step: "2",
              title: "Evaluate by crawler purpose",
              body: "Verified crawler tokens are grouped by search, training, user-triggered retrieval, or agent use.",
            },
            {
              step: "3",
              title: "Explain findings with evidence",
              body: "The report identifies explicit rules, unspecified policies, conflicts, unavailable resources, and recommended next steps.",
            },
            {
              step: "4",
              title: "Monitor changes",
              body: "Saved domains can be compared against future website responses and crawler-registry updates on paid plans.",
            },
          ].map((item) => (
            <li class="rounded-card border border-neutral-200 bg-white p-5">
              <span class="flex size-8 items-center justify-center rounded-full bg-brand-600 text-body font-semibold text-white">
                {item.step}
              </span>
              <h3 class="mt-3 text-card-heading text-neutral-950">{item.title}</h3>
              <p class="mt-1.5 text-supporting text-neutral-600">{item.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 max-w-2xl text-supporting text-neutral-500">
        Public policy auditing does not require server-log access or installation. Actual crawler
        traffic is outside the audit's proof boundary — see{" "}
        <a href="/methodology" class="text-brand-700 underline underline-offset-2">methodology</a>
        and <a href="/crawlers" class="text-brand-700 underline underline-offset-2"
          >crawler directory</a
        >.
      </p>
    </div>
  </section>

  <!-- Section 5 — Search, training, retrieval, and agents explained -->
  <CrawlerPurposeSection />

  <!-- Phase 7 — audience-specific landing pages and platform hub -->
  <VerticalsSection />

  <!-- Crawler directory preview -->
  <section class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-h2 text-neutral-950">AI crawler directory</h2>
      <a href="/crawlers" class="text-body font-medium text-brand-700 hover:underline"
        >View all crawlers</a
      >
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        crawlerPreview.map((crawler) => (
          <a
            href={`/crawlers/${crawler.id}`}
            class="rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
          >
            <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
              {crawler.data.operator}
            </p>
            <p class="mt-1 text-card-heading text-neutral-950">{crawler.data.name}</p>
            <p class="mt-1.5 text-supporting text-neutral-600">
              {CRAWLER_PURPOSE_LABELS[crawler.data.purpose]} &middot; verified{" "}
              {crawler.data.lastVerified}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Section 6 — Agency and multi-domain workflow -->
  <AgencySection />

  <!-- Section 7 — Independent evidence and methodology -->
  <section class="bg-neutral-50 py-16">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
      <h2 class="text-h2 text-neutral-950">
        Independent evidence, not another hosting-provider control panel.
      </h2>
      <p class="mt-4 max-w-2xl text-body-lg text-neutral-700">
        CrawlPact works across publicly accessible hosting setups, does not require a website to use
        one CDN, preserves the evidence behind every finding, uses a source-backed crawler registry,
        distinguishes website-policy changes from registry-driven changes, and publishes its own
        methodology and limitations.
      </p>
      <div class="mt-6 rounded-card border border-neutral-200 bg-white p-5">
        <p class="text-body font-medium text-neutral-900">{BRAND.approvedBoundaryStatement}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-body font-medium text-brand-700">
        <a
          href="/methodology"
          data-analytics-event="homepage_methodology_clicked"
          class="underline underline-offset-2">Methodology</a
        >
        <a
          href="/crawlers"
          data-analytics-event="homepage_crawler_directory_clicked"
          class="underline underline-offset-2">Crawler directory</a
        >
        <a href="/status" class="underline underline-offset-2">Status</a>
        <a href="/security" class="underline underline-offset-2">Security</a>
        <a href="/about" class="underline underline-offset-2">About</a>
        <a href="/methodology#corrections" class="underline underline-offset-2"
          >Corrections process</a
        >
      </div>
    </div>
  </section>

  <!-- Section 8 — Supported signals -->
  <section class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
    <h2 class="text-h2 text-neutral-950">Supported public signals</h2>
    <p class="mt-2 max-w-2xl text-body text-neutral-700">
      Primary signals (robots.txt, HTTP headers, HTML meta directives) are checked on every scan.
      Optional or emerging signals are checked when publicly available and evaluated according to
      the current published methodology — none is required for AI visibility.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        [
          "robots.txt",
          "AI crawler user-agent groups",
          "llms.txt",
          "llms-full.txt",
          "RSL",
          "Content Signals",
          "Robots meta",
          "X-Robots-Tag",
          "Sitemap declarations",
          "Relevant HTTP headers",
        ].map((signal) => (
          <li class="rounded-pill border border-neutral-200 bg-white px-3 py-1.5 font-mono text-supporting text-neutral-700">
            {signal}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Section 9 — Monitoring and change detection -->
  <section class="bg-neutral-50 py-16">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
      <h2 class="text-h2 text-neutral-950">A correct policy today can change tomorrow.</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-card border border-neutral-200 bg-white p-5">
          <h3 class="text-card-heading text-neutral-950">Website-policy changes</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-body text-neutral-700">
            <li>robots.txt, header, or meta directive changed</li>
            <li>A resource became unavailable</li>
            <li>A CDN rewrote the public response</li>
            <li>A deployment changed the effective policy</li>
          </ul>
        </div>
        <div class="rounded-card border border-neutral-200 bg-white p-5">
          <h3 class="text-card-heading text-neutral-950">Registry-driven changes</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-body text-neutral-700">
            <li>A new crawler token was added</li>
            <li>An operator changed its documented purpose</li>
            <li>Source verification changed</li>
            <li>Classification uncertainty changed</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 max-w-2xl text-supporting text-neutral-500">
        Monitoring frequency depends on your plan — see{" "}
        <a href="/pricing" class="text-brand-700 underline underline-offset-2">pricing</a>. Changes
        surface through an in-app notification centre and a private Atom feed.
      </p>
    </div>
  </section>

  <!-- Section 10 — Pricing preview -->
  <PricingPreviewSection />

  <!-- Section 11 — FAQ -->
  <section class="bg-neutral-50 py-16">
    <div class="mx-auto max-w-reading px-4 sm:px-6">
      <h2 class="text-h2 text-neutral-950">Frequently asked questions</h2>
      <div class="mt-6">
        <Accordion
          client:visible
          items={faqItems.map((item) => ({
            value: item.value,
            title: item.title,
            content: item.content,
          }))}
        />
      </div>
    </div>
  </section>

  <!-- FAQPage structured data — must mirror the visible FAQ above exactly (SRS §9.24) -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.title,
        acceptedAnswer: { "@type": "Answer", text: item.content },
      })),
    })}
  />

  <!-- Section 12 — Final audit CTA -->
  <section class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
    <div class="rounded-panel border border-neutral-200 bg-white p-10 text-center shadow-elevated">
      <h2 class="text-h2 text-neutral-950">See what your website currently tells AI crawlers.</h2>
      <p class="mt-2 text-body-lg text-neutral-700">
        Run a free public-policy audit with no installation or server-log access.
      </p>
      <div class="mt-6 flex justify-center">
        <AuditForm client:visible idPrefix="final-cta" />
      </div>
      <p class="mt-4 text-supporting text-neutral-500">
        Results describe published policy signals and do not guarantee crawler behaviour.
      </p>
      <a
        href="/sample-report"
        data-analytics-event="sample_report_clicked"
        class="mt-2 inline-block text-supporting font-medium text-brand-700 underline underline-offset-2"
      >
        View a sample report
      </a>
    </div>
  </section>
  <AnalyticsBeacon client:load eventName="landing_viewed" />
  <script>
    // Lightweight, unhydrated click-delegation for homepage conversion-path
    // analytics (Phase 4) — a single event listener, no client framework
    // island, matching the "avoid unnecessary client-side state" and
    // "avoid hydrating decorative sections" performance requirements.
    // Fire-and-forget; never blocks navigation, never surfaces an error.
    document.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>("[data-analytics-event]");
      if (!target) return;
      const eventName = target.dataset.analyticsEvent;
      if (!eventName) return;
      fetch("/api/analytics/track", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ eventName }),
        keepalive: true,
      }).catch(() => {
        // Analytics must never surface an error to the user.
      });
    });
  </script>
</MarketingLayout>
