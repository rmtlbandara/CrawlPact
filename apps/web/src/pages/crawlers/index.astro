---
export const prerender = true;
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { CRAWLER_PURPOSES, CRAWLER_PURPOSE_LABELS } from "@crawlpact/registry";

const crawlers = await getCollection("crawlers");

// Policy Purpose Lanes (docs/design/EVIDENCE_OBSERVATORY_REDESIGN_SPEC.md §4C): group the
// directory by purpose rather than one flat alphabetical list, for scannability across 20+
// entries. Only purposes with at least one real entry render a section.
const purposeGroups = CRAWLER_PURPOSES.map((purpose) => ({
  purpose,
  label: CRAWLER_PURPOSE_LABELS[purpose],
  crawlers: crawlers
    .filter((crawler) => crawler.data.purpose === purpose)
    .sort((a, b) => a.data.name.localeCompare(b.data.name)),
})).filter((group) => group.crawlers.length > 0);
---

<MarketingLayout
  title="AI Crawler Directory | CrawlPact"
  description="Reference pages for documented AI search, training, user-triggered, and agent crawlers, with official sources and last-verified dates."
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">AI crawler directory</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      Reference pages for AI crawlers CrawlPact's registry tracks, each with its purpose, official
      source, and last-verified date. This is a growing, versioned registry — see{" "}
      <a href="/methodology" class="text-brand-700 underline underline-offset-2"> methodology </a>{
        " "
      }
      for how entries are verified.
    </p>

    {
      purposeGroups.map((group) => (
        <section class="mt-10 first:mt-8">
          <h2 class="text-h3 text-neutral-950">{group.label}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.crawlers.map((crawler) => (
              <li class="rounded-card border border-neutral-200 bg-white p-5">
                <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
                  {crawler.data.operator}
                </p>
                <h3 class="mt-1 text-card-heading text-neutral-950">
                  <a href={`/crawlers/${crawler.id}`} class="hover:text-brand-700">
                    {crawler.data.name}
                  </a>
                </h3>
                <p class="mt-2 text-body text-neutral-700">{crawler.data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</MarketingLayout>
