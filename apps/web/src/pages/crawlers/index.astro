---
export const prerender = true;
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { CRAWLER_PURPOSE_LABELS } from "@crawlpact/registry";

const crawlers = (await getCollection("crawlers")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<MarketingLayout
  title="AI Crawler Directory | CrawlPact"
  description="Reference pages for documented AI search, training, user-triggered, and agent crawlers, with official sources and last-verified dates."
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">AI crawler directory</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      Reference pages for AI crawlers CrawlPact's registry tracks, each with its purpose, official
      source, and last-verified date. This is a growing, versioned registry — see
      <a href="/methodology" class="text-brand-700 underline underline-offset-2">methodology</a>
      for how entries are verified.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        crawlers.map((crawler) => (
          <li class="rounded-card border border-neutral-200 bg-white p-5">
            <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
              {crawler.data.operator}
            </p>
            <h2 class="mt-1 text-card-heading text-neutral-950">
              <a href={`/crawlers/${crawler.id}`} class="hover:text-brand-700">
                {crawler.data.name}
              </a>
            </h2>
            <p class="mt-2 text-supporting text-neutral-600">
              {CRAWLER_PURPOSE_LABELS[crawler.data.purpose]}
            </p>
            <p class="mt-2 text-body text-neutral-700">{crawler.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</MarketingLayout>
