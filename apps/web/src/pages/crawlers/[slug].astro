---
export const prerender = true;
import { getCollection, render } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../../components/AnalyticsBeacon";
import { CRAWLER_PURPOSE_LABELS } from "@crawlpact/registry";

export async function getStaticPaths() {
  const crawlers = await getCollection("crawlers");
  return crawlers.map((crawler) => ({ params: { slug: crawler.id }, props: { crawler } }));
}

const { crawler } = Astro.props;
const { Content } = await render(crawler);

const allCrawlers = await getCollection("crawlers");
const relatedCrawlers = allCrawlers
  .filter(
    (other) =>
      other.id !== crawler.id &&
      (other.data.operator === crawler.data.operator ||
        other.data.purpose === crawler.data.purpose),
  )
  .slice(0, 3);

const allGuides = await getCollection("guides");
const relatedGuides = allGuides.filter((guide) =>
  guide.data.relatedCrawlerSlugs?.includes(crawler.id),
);
---

<MarketingLayout
  title={`${crawler.data.name} (${crawler.data.operator}) | CrawlPact Crawler Directory`}
  description={crawler.data.summary}
  canonicalPath={`/crawlers/${crawler.id}/`}
  ogImage="/og/crawlers.png"
  ogType="article"
  publishedDate={crawler.data.lastVerified}
  breadcrumbs={[
    { name: "Crawler directory", url: "/crawlers" },
    { name: crawler.data.name, url: `/crawlers/${crawler.id}/` },
  ]}
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
      {crawler.data.operator}
    </p>
    <h1 class="mt-1 text-h1 text-neutral-950">{crawler.data.name}</h1>
    <dl
      class="mt-4 grid grid-cols-2 gap-4 rounded-card border border-neutral-200 bg-neutral-50 p-4 text-supporting sm:grid-cols-4"
    >
      <div>
        <dt class="text-neutral-500">User-agent token</dt>
        <dd class="font-mono text-neutral-900">{crawler.data.userAgentToken}</dd>
      </div>
      <div>
        <dt class="text-neutral-500">Purpose</dt>
        <dd class="text-neutral-900">{CRAWLER_PURPOSE_LABELS[crawler.data.purpose]}</dd>
      </div>
      <div>
        <dt class="text-neutral-500">Status</dt>
        <dd class="text-neutral-900">{crawler.data.lifecycleStatus}</dd>
      </div>
      <div>
        <dt class="text-neutral-500">Last verified</dt>
        <dd class="text-neutral-900">{crawler.data.lastVerified}</dd>
      </div>
    </dl>

    <div class="prose prose-neutral mt-8 max-w-none wrap-break-word text-body text-neutral-800">
      <Content />
    </div>

    <h2 class="mt-8 text-h3 text-neutral-950">Example robots.txt configuration</h2>
    <p class="mt-2 text-body text-neutral-700">
      To disallow {crawler.data.name} specifically, without affecting any other crawler:
    </p>
    <pre
      class="mt-3 overflow-x-auto rounded-card bg-neutral-950 p-4 text-supporting text-neutral-50"><code>User-agent: {crawler.data.userAgentToken}
Disallow: /</code></pre>
    <p class="mt-3 text-body text-neutral-700">
      If no dedicated <code>User-agent: {crawler.data.userAgentToken}</code> group exists in a domain's{
        " "
      }
      <code>robots.txt</code>, this crawler falls back to whatever the wildcard{" "}
      <code>User-agent: *</code> group says (RFC 9309) — see{" "}
      <a
        href="/guides/robots-txt-syntax-basics/"
        class="text-brand-700 underline underline-offset-2">robots.txt syntax basics</a
      > for how group selection works.
    </p>

    <a
      href={crawler.data.officialSourceUrl}
      class="mt-6 block wrap-break-word text-body text-brand-700 underline underline-offset-2"
      rel="noopener"
    >
      Official source: {crawler.data.officialSourceUrl}
    </a>
    <p class="mt-2 text-supporting text-neutral-500">
      Verified against the source above as of {crawler.data.lastVerified} — see{" "}
      <a
        href="/methodology#registry-verification"
        class="text-brand-700 underline underline-offset-2"
        >how CrawlPact verifies crawler information</a
      >.
    </p>

    {
      relatedGuides.length > 0 && (
        <div class="mt-12 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related guides</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {relatedGuides.map((guide) => (
              <li>
                <a
                  href={`/guides/${guide.id}/`}
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-card-heading text-neutral-950">{guide.data.title}</p>
                  <p class="mt-1 text-supporting text-neutral-600">{guide.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      relatedCrawlers.length > 0 && (
        <div class="mt-12 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related crawlers</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {relatedCrawlers.map((related) => (
              <li>
                <a
                  href={`/crawlers/${related.id}/`}
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
                    {related.data.operator}
                  </p>
                  <p class="mt-1 text-card-heading text-neutral-950">{related.data.name}</p>
                  <p class="mt-1 text-supporting text-neutral-600">
                    {CRAWLER_PURPOSE_LABELS[related.data.purpose]}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8 rounded-card border border-neutral-200 bg-neutral-50 p-6 text-center">
      <p class="text-card-heading text-neutral-950">See how this applies to your own site</p>
      <p class="mt-1.5 text-supporting text-neutral-600">
        Run a free audit to check your declared AI crawler policy against your own domain, or use
        the <a href="/tools/ai-crawler-checker/" class="text-brand-700 underline underline-offset-2"
          >AI crawler checker</a
        > to check this one crawler specifically.
      </p>
      <a
        href="/audit"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Audit a domain
      </a>
    </div>
  </article>
  <AnalyticsBeacon
    client:load
    eventName="crawler_reference_page_opened"
    properties={{ crawlerId: crawler.id }}
  />
</MarketingLayout>
