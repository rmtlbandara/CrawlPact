---
export const prerender = true;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { Banner } from "@crawlpact/ui";
import { AuditReportView } from "../components/AuditReportView";
import { SAMPLE_REPORT } from "../lib/sample-report.fixture";
---

<MarketingLayout
  title="Sample AI Crawler Policy Report | CrawlPact"
  description="See the full structure of a CrawlPact AI crawler policy report — findings, evidence, recommendations, and limitations — using a fictional demonstration domain, not a real scan."
>
  <div class="mx-auto max-w-[960px] px-4 py-10 sm:px-6">
    <div class="no-print mb-6 overflow-hidden rounded-card">
      <Banner tone="information">
        Sample report — demonstrates report structure using a fictional domain. This is not a live
        audit of your website.
      </Banner>
    </div>
    <div class="flex flex-col gap-6">
      <AuditReportView
        client:load
        report={SAMPLE_REPORT}
        proposedRobotsText={null}
        diffLines={null}
      />
    </div>
    <div class="no-print mt-10 rounded-panel border border-neutral-200 bg-white p-8 text-center">
      <h2 class="text-h3 text-neutral-950">Ready to audit your own website?</h2>
      <p class="mt-2 text-body text-neutral-700">
        Run a free public audit — no installation or server-log access required.
      </p>
      <a
        href="/#hero-audit-form"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Audit a domain
      </a>
    </div>
  </div>
</MarketingLayout>
