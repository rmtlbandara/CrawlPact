---
export const prerender = false;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../lib/env";
import { getAdminEnvironment } from "../lib/admin/environment";
import { getPublicStatus, type PublicStatusLevel } from "../lib/status/public-status";

const db = createDb(getEnv().DB);
const auditEngineEnabled = getEnv().AUDIT_ENGINE_ENABLED === "true";
const environment = getAdminEnvironment();
const report = await getPublicStatus(db);

Astro.response.headers.set("Cache-Control", "public, max-age=30");

const LEVEL_LABEL: Record<PublicStatusLevel, string> = {
  operational: "Operational",
  degraded_performance: "Degraded performance",
  partial_outage: "Partial outage",
  major_outage: "Major outage",
  maintenance: "Maintenance",
  status_unavailable: "Status unavailable",
};

const LEVEL_TONE_CLASS: Record<PublicStatusLevel, string> = {
  operational: "text-success",
  degraded_performance: "text-warning",
  partial_outage: "text-warning",
  major_outage: "text-error",
  maintenance: "text-neutral-500",
  status_unavailable: "text-neutral-500",
};

const LEVEL_SUMMARY: Record<PublicStatusLevel, string> = {
  operational: "All public CrawlPact services are operating normally.",
  degraded_performance:
    "Some CrawlPact services are experiencing degraded performance. See components and incidents below for detail.",
  partial_outage:
    "Part of CrawlPact is currently unavailable. See components and incidents below for detail.",
  major_outage: "CrawlPact is currently broadly unavailable. See incidents below for detail.",
  maintenance: "Scheduled maintenance is currently affecting some CrawlPact services.",
  status_unavailable:
    "Current status could not be determined. This page never reports Operational when a check fails.",
};

// The two components with a real, verifiable config-derived signal keep
// that detail text — this system only escalates their displayed status
// with incidents, it does not replace the existing checks.
const COMPONENT_DETAIL: Partial<Record<string, string>> = {
  audit_scanner: `Free audit (real scan): ${auditEngineEnabled ? "Available" : "Disabled in this environment"}.`,
  billing_checkout: environment.paddleBillingConfigured
    ? `Paddle billing available (${environment.label}).`
    : "Paddle billing not configured in this environment.",
};

function formatTimestamp(iso: string): string {
  return new Date(iso)
    .toISOString()
    .replace("T", " ")
    .replace(/\.\d+Z$/, " UTC");
}
---

<MarketingLayout
  title="Status | CrawlPact"
  description="Current CrawlPact platform status, active incidents, scheduled maintenance, and recently resolved incidents."
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Status</h1>
    <p class="mt-3 text-body text-neutral-700">
      This page reflects real, currently-recorded incidents and configuration state — never a
      hardcoded "Operational."
    </p>

    <div class="mt-6 rounded-card border border-neutral-200 bg-white px-4 py-3">
      <p class="text-supporting text-neutral-500">Overall status</p>
      <p class={`text-h3 ${LEVEL_TONE_CLASS[report.overall]}`}>{LEVEL_LABEL[report.overall]}</p>
      <p class="mt-1 text-body text-neutral-700">{LEVEL_SUMMARY[report.overall]}</p>
      <p class="mt-1 text-supporting text-neutral-500">
        Last checked {formatTimestamp(report.checkedAt)}
      </p>
    </div>

    <h2 class="mt-8 text-h2 text-neutral-950">Components</h2>
    <ul class="mt-4 flex flex-col gap-3">
      {
        report.components.map((c) => (
          <li class="flex items-center justify-between rounded-card border border-neutral-200 bg-white px-4 py-3">
            <span class="text-body text-neutral-800">
              {c.label}
              {COMPONENT_DETAIL[c.key] && (
                <span class="block text-supporting text-neutral-500">
                  {COMPONENT_DETAIL[c.key]}
                </span>
              )}
            </span>
            <span class={`text-supporting font-medium ${LEVEL_TONE_CLASS[c.status]}`}>
              {LEVEL_LABEL[c.status]}
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-8 text-h2 text-neutral-950">Current incidents</h2>
    {
      report.currentIncidents.length === 0 ? (
        <p class="mt-3 text-body text-neutral-700">No current incidents.</p>
      ) : (
        <ul class="mt-4 flex flex-col gap-4">
          {report.currentIncidents.map((incident) => (
            <li class="rounded-card border border-neutral-200 bg-white p-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-card-heading text-neutral-950">{incident.title}</p>
                <span class="text-supporting font-medium text-warning">{incident.status}</span>
              </div>
              <p class="mt-1.5 text-body text-neutral-700">{incident.publicSummary}</p>
              <ul class="mt-3 flex flex-col gap-2 border-l-2 border-neutral-200 pl-3">
                {incident.updates.map((update) => (
                  <li>
                    <p class="text-supporting text-neutral-500">
                      {formatTimestamp(update.createdAt)} · {update.status}
                    </p>
                    <p class="text-body text-neutral-700">{update.message}</p>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )
    }

    <h2 class="mt-8 text-h2 text-neutral-950">Scheduled maintenance</h2>
    {
      report.scheduledMaintenance.length === 0 ? (
        <p class="mt-3 text-body text-neutral-700">No scheduled maintenance.</p>
      ) : (
        <ul class="mt-4 flex flex-col gap-4">
          {report.scheduledMaintenance.map((incident) => (
            <li class="rounded-card border border-neutral-200 bg-white p-4">
              <p class="text-card-heading text-neutral-950">{incident.title}</p>
              <p class="mt-1 text-supporting text-neutral-500">
                Starts {formatTimestamp(incident.startsAt)}
              </p>
              <p class="mt-1.5 text-body text-neutral-700">{incident.publicSummary}</p>
            </li>
          ))}
        </ul>
      )
    }

    <h2 class="mt-8 text-h2 text-neutral-950">Recently resolved</h2>
    {
      report.recentlyResolved.length === 0 ? (
        <p class="mt-3 text-body text-neutral-700">No recently resolved incidents.</p>
      ) : (
        <ul class="mt-4 flex flex-col gap-3">
          {report.recentlyResolved.map((incident) => (
            <li class="rounded-card border border-neutral-200 bg-white px-4 py-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-body text-neutral-800">{incident.title}</span>
                <span class="text-supporting text-neutral-500">
                  Resolved {incident.resolvedAt && formatTimestamp(incident.resolvedAt)}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-8 text-supporting text-neutral-500">
      See <a href="/security" class="text-brand-700 underline underline-offset-2">security</a> for how
      CrawlPact handles vulnerability reports.
    </p>
  </article>
</MarketingLayout>
