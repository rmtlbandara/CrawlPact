---
export const prerender = false;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { getEnv } from "../lib/env";
import { getAdminEnvironment } from "../lib/admin/environment";

const auditEngineEnabled = getEnv().AUDIT_ENGINE_ENABLED === "true";
const environment = getAdminEnvironment();

const capabilities = [
  { name: "Public website", state: "Available" },
  {
    name: "Free audit (real scan)",
    state: auditEngineEnabled ? "Available" : "Disabled in this environment",
  },
  { name: "Account registration (passkeys)", state: "Available" },
  { name: "Saved domains and monitoring", state: "Available" },
  {
    name: "Paddle billing",
    state: environment.paddleBillingConfigured
      ? `Available (${environment.label})`
      : "Not configured in this environment",
  },
  { name: "Super Admin Control Center", state: "Available (authorised administrators)" },
];
---

<MarketingLayout
  title="Status | CrawlPact"
  description="Current CrawlPact platform status and which capabilities are enabled in this environment."
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Status</h1>
    <p class="mt-3 text-body text-neutral-700">
      CrawlPact is under active development. This page states plainly what is and is not enabled
      right now, rather than implying capabilities that do not exist yet.
    </p>
    <ul class="mt-8 flex flex-col gap-3">
      {
        capabilities.map((item) => (
          <li class="flex items-center justify-between rounded-card border border-neutral-200 bg-white px-4 py-3">
            <span class="text-body text-neutral-800">{item.name}</span>
            <span
              class={`text-supporting font-medium ${item.state.startsWith("Available") ? "text-success" : "text-neutral-500"}`}
            >
              {item.state}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-supporting text-neutral-500">
      See the project's <code>docs/status/IMPLEMENTATION_STATUS.md</code> for the full engineering-level
      status.
    </p>
  </article>
</MarketingLayout>
