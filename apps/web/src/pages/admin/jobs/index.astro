---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { SchedulerManager } from "../../../components/admin/SchedulerManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Scheduled jobs" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Scheduled jobs"
    description="Monitoring and retention job history, anomaly detection, and a global pause (SRS §28.10)."
  />
  <div class="mt-6">
    <SchedulerManager client:load />
  </div>
</AdminLayout>
