---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import { MetricCard, StatusChip } from "@crawlpact/ui";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../lib/env";
import { getAdminPageSession } from "../../lib/auth/require-admin";
import { getDashboardMetrics } from "../../lib/admin/dashboard";
import { getSystemStatusSummary } from "../../lib/admin/health";
import { DATE_RANGE_LABELS, resolveDateRange } from "../../lib/admin/date-range";
import type { DateRangePreset } from "../../lib/admin/date-range";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");

const presetParam = (Astro.url.searchParams.get("range") ?? "30d") as DateRangePreset;
const preset: DateRangePreset = presetParam in DATE_RANGE_LABELS ? presetParam : "30d";
const customFrom = Astro.url.searchParams.get("from");
const customTo = Astro.url.searchParams.get("to");
const range =
  preset === "custom" && customFrom && customTo
    ? resolveDateRange("custom", { from: customFrom, to: customTo })
    : resolveDateRange(preset === "custom" ? "30d" : preset);

const metrics = await getDashboardMetrics(db, range);
const status = await getSystemStatusSummary(db);

function formatUsd(cents: number): string {
  return `$${(cents / 100).toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
}
---

<AdminLayout title="Global dashboard" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Global dashboard"
    description="Platform-wide operational and revenue overview."
    metadata={`Flow metrics for ${DATE_RANGE_LABELS[range.preset]} (${new Date(range.from).toLocaleDateString()} – ${new Date(range.to).toLocaleDateString()}). Snapshot metrics reflect current state regardless of range.`}
  />

  <div class="mt-6 flex flex-wrap items-center gap-2">
    {
      (Object.keys(DATE_RANGE_LABELS) as DateRangePreset[])
        .filter((p) => p !== "custom")
        .map((p) => (
          <a
            href={`/admin?range=${p}`}
            class={`rounded-control px-3 py-1.5 text-supporting font-medium ${
              range.preset === p
                ? "bg-brand-600 text-white"
                : "border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-50"
            }`}
          >
            {DATE_RANGE_LABELS[p]}
          </a>
        ))
    }
  </div>

  {
    !metrics.environment.isRealRevenue && (
      <div class="mt-4 rounded-card border border-warning bg-warning-bg px-4 py-3 text-supporting text-warning">
        Revenue figures below are from <strong>{metrics.environment.paddleEnvironment}</strong>{" "}
        Paddle data ({metrics.environment.label}) — not real production revenue. See
        docs/security/BILLING_SECURITY.md.
      </div>
    )
  }

  <section class="mt-8">
    <h2 class="text-h2 text-neutral-950">Current state</h2>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      <MetricCard label="Total users" value={metrics.snapshot.totalUsers} />
      <MetricCard label="Suspended users" value={metrics.snapshot.suspendedUsers} />
      <MetricCard label="Paying customers" value={metrics.snapshot.payingCustomers} />
      <MetricCard label="Active subscriptions" value={metrics.snapshot.activeSubscriptions} />
      <MetricCard label="Past-due subscriptions" value={metrics.snapshot.pastDueSubscriptions} />
      <MetricCard label="Cancelled subscriptions" value={metrics.snapshot.cancelledSubscriptions} />
      <MetricCard label="Saved domains" value={metrics.snapshot.savedDomains} />
      <MetricCard label="Monitored domains" value={metrics.snapshot.monitoredDomains} />
      <MetricCard
        label="Estimated ARR"
        value={formatUsd(metrics.snapshot.estimatedArrUsdCents)}
        helpText="From active subscriptions' plan price"
      />
      <MetricCard
        label="Estimated monthly recurring"
        value={formatUsd(metrics.snapshot.estimatedMonthlyRecurringUsdCents)}
        helpText="Estimated ARR ÷ 12"
      />
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-h2 text-neutral-950">Activity in range</h2>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      <MetricCard label="New users" value={metrics.flow.newUsers} />
      <MetricCard
        label="Active users"
        value={metrics.flow.activeUsers}
        helpText="Had a session in range"
      />
      <MetricCard label="Completed scans" value={metrics.flow.completedScans} />
      <MetricCard label="Failed scans" value={metrics.flow.failedScans} />
      <MetricCard label="Critical findings" value={metrics.flow.criticalFindings} />
      <MetricCard label="Security events" value={metrics.flow.securityEvents} />
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-h2 text-neutral-950">Revenue in range</h2>
    {
      metrics.flow.revenueByCurrency.length === 0 ? (
        <p class="mt-4 text-body text-neutral-600">No transactions in this range.</p>
      ) : (
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {metrics.flow.revenueByCurrency.map((r) => (
            <div class="rounded-card border border-neutral-200 bg-white p-4">
              <p class="text-supporting font-medium text-neutral-600">{r.currency}</p>
              <p class="mt-1 text-h3 text-neutral-950">
                {(r.grossCents / 100).toLocaleString("en-US", {
                  style: "currency",
                  currency: r.currency,
                })}
              </p>
              <p class="mt-2 text-supporting text-neutral-600">
                Refunded:{" "}
                {(r.refundedCents / 100).toLocaleString("en-US", {
                  style: "currency",
                  currency: r.currency,
                })}{" "}
                · Chargebacks: {r.chargebackCount}
              </p>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="mt-10">
    <h2 class="text-h2 text-neutral-950">System status</h2>
    <div class="mt-4">
      <StatusChip
        tone={status.status === "operational"
          ? "success"
          : status.status === "degraded"
            ? "warning"
            : "info"}
        label={status.status === "operational"
          ? "All systems operational"
          : status.status === "maintenance"
            ? "Maintenance mode"
            : `Degraded: ${status.reasons.join(" ")}`}
      />
      <a href="/admin/health" class="ml-3 text-supporting text-brand-700 hover:underline">
        View system health →
      </a>
    </div>
  </section>
</AdminLayout>
