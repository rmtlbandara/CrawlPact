---
export const prerender = false;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import { RegistryReleasesManager } from "../../../../components/admin/RegistryReleasesManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../../lib/env";
import { getAdminPageSession } from "../../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Registry releases" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Registry releases"
    description="Create, compare, publish, and roll back registry releases (SRS §28.11). Published releases are immutable."
  />
  <div class="mt-6">
    <RegistryReleasesManager client:load />
  </div>
</AdminLayout>
