---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { GlobalDomainsManager } from "../../../components/admin/GlobalDomainsManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Domains" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Domains"
    description="Every saved domain across every customer (SRS §28.8)."
  />
  <div class="mt-6">
    <GlobalDomainsManager client:load />
  </div>
</AdminLayout>
