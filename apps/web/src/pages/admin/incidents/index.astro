---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { IncidentsManager } from "../../../components/admin/IncidentsManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Incidents" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Incidents"
    description="Create and update incidents shown on the public status page."
  />
  <div class="mt-6">
    <IncidentsManager client:load />
  </div>
</AdminLayout>
