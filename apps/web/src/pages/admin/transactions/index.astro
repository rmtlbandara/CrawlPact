---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { TransactionsManager } from "../../../components/admin/TransactionsManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Transactions" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Transactions"
    description="Paddle transaction records (SRS §28.6). Only fields Paddle actually sends are shown."
  />
  <div class="mt-6">
    <TransactionsManager client:load />
  </div>
</AdminLayout>
