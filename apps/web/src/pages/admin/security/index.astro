---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { SecurityOperationsDashboard } from "../../../components/admin/SecurityOperationsDashboard";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Security events" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Security events"
    description="Unsafe targets, rate limits, auth/recovery failures, suspicious sessions, and administrator actions (SRS §28.14)."
  />
  <div class="mt-6">
    <SecurityOperationsDashboard client:load />
  </div>
</AdminLayout>
