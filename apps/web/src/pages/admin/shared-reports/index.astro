---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { SharedReportsManager } from "../../../components/admin/SharedReportsManager";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../../lib/env";
import { getAdminPageSession } from "../../../lib/auth/require-admin";

const db = createDb(getEnv().DB);
const admin = await getAdminPageSession(Astro.request, db);
if (!admin) return Astro.redirect("/sign-in");
---

<AdminLayout title="Shared reports" displayName={admin.user.displayName}>
  <AdminPageHeader
    title="Shared reports"
    description="Every public report link across every customer (SRS §28.9)."
  />
  <div class="mt-6">
    <SharedReportsManager client:load />
  </div>
</AdminLayout>
