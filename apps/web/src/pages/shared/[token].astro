---
export const prerender = false;
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { ErrorState } from "@crawlpact/ui";
import { AuditReportView } from "../../components/AuditReportView";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../lib/env";
import { getShareForToken } from "../../lib/sharing";
import { loadReportViewData } from "../../lib/report-view-data";

const { token } = Astro.params;

const db = createDb(getEnv().DB);
const share = token ? await getShareForToken(db, token) : { status: "invalid" as const };
const { report, diffLines, proposedRobotsText } =
  share.status === "valid"
    ? await loadReportViewData(db, share.scanId)
    : { report: null, diffLines: null, proposedRobotsText: null };

const UNAVAILABLE_COPY: Record<
  "revoked" | "expired" | "invalid",
  { title: string; description: string }
> = {
  revoked: {
    title: "This shared link has been revoked",
    description: "The person who shared this report has revoked access to it.",
  },
  expired: {
    title: "This shared link has expired",
    description: "This link was created with an expiry date, and that date has passed.",
  },
  invalid: {
    title: "This shared link is not available",
    description: "This link doesn't match any active shared report.",
  },
};
---

<MarketingLayout
  title={report
    ? `${report.domain} — Shared AI crawler policy report | CrawlPact`
    : "Shared report | CrawlPact"}
  description="A shared AI crawler policy report."
  noindex={true}
>
  <div class="mx-auto max-w-[960px] px-4 py-16 sm:px-6">
    {
      report && share.status === "valid" ? (
        <AuditReportView
          client:load
          report={report}
          proposedRobotsText={proposedRobotsText}
          diffLines={diffLines}
          agencyBranding={share.agencyBranding}
        />
      ) : (
        <ErrorState
          client:load
          title={UNAVAILABLE_COPY[share.status === "valid" ? "invalid" : share.status].title}
          description={
            UNAVAILABLE_COPY[share.status === "valid" ? "invalid" : share.status].description
          }
        />
      )
    }
  </div>
</MarketingLayout>
