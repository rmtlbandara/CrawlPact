---
export const prerender = true;
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AuditForm } from "../../components/AuditForm";
---

<MarketingLayout
  title="RSL Validator | Free Tool | CrawlPact"
  description="Validate supported RSL syntax and view declared permissions, prohibitions, and licensing terms for a domain."
  breadcrumbs={[
    { name: "Free tools", url: "/tools" },
    { name: "RSL validator", url: "/tools/rsl-validator" },
  ]}
>
  <div class="mx-auto max-w-reading px-4 py-16 text-center sm:px-6">
    <h1 class="text-h1 text-neutral-950">RSL validator</h1>
    <p class="mt-4 text-body-lg text-neutral-700">
      Enter a domain to discover its RSL declaration at <code>/.well-known/rsl.xml</code> and see its
      declared permits, prohibits, and payment terms. RSL is a machine-readable declaration, not technical
      enforcement — see{" "}
      <a href="/limitations" class="text-brand-700 underline underline-offset-2">limitations</a>.
    </p>
    <div class="mt-8 flex justify-center">
      <AuditForm client:load idPrefix="rsl-validator" focus="rsl" />
    </div>
  </div>
</MarketingLayout>
