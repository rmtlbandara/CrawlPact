---
export const prerender = true;
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AuditForm } from "../../components/AuditForm";
---

<MarketingLayout
  title="AI Crawler Checker | Free Tool | CrawlPact"
  description="Check whether documented AI crawlers such as GPTBot, ClaudeBot, and PerplexityBot appear allowed or blocked for a domain."
  ogImage="/og/tools.png"
  breadcrumbs={[
    { name: "Free tools", url: "/tools" },
    { name: "AI crawler checker", url: "/tools/ai-crawler-checker/" },
  ]}
>
  <div class="mx-auto max-w-reading px-4 py-16 text-center sm:px-6">
    <h1 class="text-h1 text-neutral-950">AI crawler checker</h1>
    <p class="mt-4 text-body-lg text-neutral-700">
      Enter a domain to see whether documented AI crawlers — GPTBot, ClaudeBot, PerplexityBot, and
      others in CrawlPact's registry — appear allowed or blocked, with the exact matched{" "}
      <code>robots.txt</code> rule and line for each.
    </p>
    <div class="mt-8 flex justify-center">
      <AuditForm client:load idPrefix="ai-crawler-checker" focus="crawlers" />
    </div>

    <div class="mt-12 text-left">
      <h2 class="text-h3 text-neutral-950">What this checks</h2>
      <ul class="mt-3 list-disc pl-5 text-body text-neutral-700">
        <li>
          Runs a full CrawlPact scan of the domain and takes you straight to the crawler-by-crawler
          findings.
        </li>
        <li>
          For each crawler in CrawlPact's registry, shows whether it appears allowed or blocked by
          the retrieved <code>robots.txt</code>, and the exact matched rule and line.
        </li>
        <li>
          Distinguishes search, training, user-triggered, and agent crawlers from the same operator
          (for example OpenAI's <code>OAI-SearchBot</code>, <code>GPTBot</code>, and{" "}
          <code>ChatGPT-User</code>), since blocking one does not affect the others.
        </li>
      </ul>

      <h2 class="mt-8 text-h3 text-neutral-950">What this does not check</h2>
      <p class="mt-3 text-body text-neutral-700">
        This reports declared policy and CrawlPact's own retrieved response — not whether any
        crawler actually obeys it, and not crawlers absent from CrawlPact's registry. See{" "}
        <a href="/limitations" class="text-brand-700 underline underline-offset-2">limitations</a>{
          " "
        }
        for the full list of boundaries.
      </p>

      <h2 class="mt-8 text-h3 text-neutral-950">Related</h2>
      <ul class="mt-3 list-disc pl-5 text-body text-neutral-700">
        <li>
          <a href="/crawlers" class="text-brand-700 underline underline-offset-2"
            >Browse the full crawler directory</a
          >
        </li>
        <li>
          <a
            href="/guides/gptbot-vs-oai-searchbot-vs-chatgpt-user/"
            class="text-brand-700 underline underline-offset-2"
            >GPTBot vs. OAI-SearchBot vs. ChatGPT-User: which should you block?</a
          >
        </li>
        <li>
          <a href="/methodology" class="text-brand-700 underline underline-offset-2"
            >How CrawlPact matches crawler tokens to rules</a
          >
        </li>
      </ul>
    </div>

    <div class="mt-8 rounded-card border border-neutral-200 bg-neutral-50 p-6 text-center">
      <p class="text-card-heading text-neutral-950">Want the complete picture?</p>
      <p class="mt-1.5 text-supporting text-neutral-600">
        This checker is a view into a full CrawlPact audit, which also covers <code>llms.txt</code>,
        RSL, Content Signals, and your Policy Health Score.
      </p>
      <a
        href="/audit"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Run the full audit
      </a>
    </div>
  </div>
</MarketingLayout>
