---
export const prerender = true;
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AuditForm } from "../../components/AuditForm";
---

<MarketingLayout
  title="Content Signals Checker | Free Tool | CrawlPact"
  description="Detect recognised Content Signals for a domain and identify contradictions with crawler-specific rules."
  ogImage="/og/tools.png"
  breadcrumbs={[
    { name: "Free tools", url: "/tools" },
    { name: "Content Signals checker", url: "/tools/content-signals-checker/" },
  ]}
>
  <div class="mx-auto max-w-reading px-4 py-16 text-center sm:px-6">
    <h1 class="text-h1 text-neutral-950">Content Signals checker</h1>
    <p class="mt-4 text-body-lg text-neutral-700">
      Enter a domain to detect a recognised <code>Content-Signal</code> response header, plus its meta
      robots tag, <code>X-Robots-Tag</code> header, and canonical URL — and flag any disagreement against
      its RSL declaration or <code>robots.txt</code> rules.
    </p>
    <div class="mt-8 flex justify-center">
      <AuditForm client:load idPrefix="content-signals-checker" focus="content-signals" />
    </div>

    <div class="mt-12 text-left">
      <h2 class="text-h3 text-neutral-950">What this checks</h2>
      <ul class="mt-3 list-disc pl-5 text-body text-neutral-700">
        <li>
          Detects a <code>Content-Signal</code> response header and its declared{" "}
          <code>search</code>/<code>ai-train</code>/<code>ai-input</code> values.
        </li>
        <li>
          Also checks meta robots tags, the <code>X-Robots-Tag</code> header, and the canonical URL for
          the same page.
        </li>
        <li>
          Flags disagreement between Content Signals and the domain's RSL declaration or <code
            >robots.txt</code
          > rules.
        </li>
      </ul>

      <h2 class="mt-8 text-h3 text-neutral-950">What this does not check</h2>
      <p class="mt-3 text-body text-neutral-700">
        Content Signals is a proposal (published by Cloudflare, September 2025) — not a ratified
        standard, and no major crawler is currently known to honour it in practice. A separate, more
        formal IETF effort (AI Preferences) is still in draft. See{" "}
        <a href="/limitations" class="text-brand-700 underline underline-offset-2">limitations</a>.
      </p>

      <h2 class="mt-8 text-h3 text-neutral-950">Related</h2>
      <ul class="mt-3 list-disc pl-5 text-body text-neutral-700">
        <li>
          <a
            href="/guides/how-to-set-the-content-signal-header/"
            class="text-brand-700 underline underline-offset-2"
            >How to set the Content-Signal HTTP header</a
          >
        </li>
        <li>
          <a
            href="/guides/rsl-vs-content-signals-vs-robots-txt/"
            class="text-brand-700 underline underline-offset-2"
            >RSL vs. Content Signals vs. robots.txt: which one wins when they disagree</a
          >
        </li>
      </ul>
    </div>

    <div class="mt-8 rounded-card border border-neutral-200 bg-neutral-50 p-6 text-center">
      <p class="text-card-heading text-neutral-950">Want the complete picture?</p>
      <p class="mt-1.5 text-supporting text-neutral-600">
        This checker is a view into a full CrawlPact audit, which also covers{" "}
        <code>robots.txt</code>, <code>llms.txt</code>, RSL, and your Policy Health Score.
      </p>
      <a
        href="/audit"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Run the full audit
      </a>
    </div>
  </div>
</MarketingLayout>
