---
export const prerender = true;
import { getCollection, render } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const allGuides = await getCollection("guides");
const relatedGuides = allGuides
  .filter((other) => other.id !== guide.id && other.data.category === guide.data.category)
  .slice(0, 3);

// Only worth a table of contents once a guide has enough sections to need
// one — shorter guides (a couple of headings) read fine top-to-bottom.
const tocHeadings = headings.filter((h) => h.depth <= 2);
const showToc = tocHeadings.length >= 3;

// HowTo schema only for guides with real, numbered "Step N" headings — never
// fabricated for guides that aren't actually structured as sequential steps.
const stepHeadings = headings.filter((h) => /^step\s+\d+/i.test(h.text));
const howToJsonLd =
  stepHeadings.length >= 2
    ? {
        "@type": "HowTo",
        name: guide.data.title,
        description: guide.data.description,
        step: stepHeadings.map((h) => ({ "@type": "HowToStep", name: h.text })),
      }
    : null;
---

<MarketingLayout
  title={`${guide.data.title} | CrawlPact Guides`}
  description={guide.data.description}
  canonicalPath={`/guides/${guide.id}/`}
  ogImage="/og/guides.png"
  ogType="article"
  publishedDate={guide.data.publishedDate}
  updatedDate={guide.data.updatedDate}
  breadcrumbs={[
    { name: "Guides", url: "/guides" },
    { name: guide.data.title, url: `/guides/${guide.id}/` },
  ]}
  extraJsonLd={howToJsonLd ? [howToJsonLd] : []}
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
      {guide.data.category}
    </p>
    <h1 class="mt-1 text-h1 text-neutral-950">{guide.data.title}</h1>
    <p class="mt-2 text-supporting text-neutral-500">
      Published {new Date(guide.data.publishedDate).toLocaleDateString()}
      {
        guide.data.updatedDate && (
          <> · Updated {new Date(guide.data.updatedDate).toLocaleDateString()}</>
        )
      }
    </p>

    {
      showToc && (
        <nav
          aria-label="Table of contents"
          class="mt-6 rounded-card border border-neutral-200 bg-neutral-50 p-4"
        >
          <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
            On this page
          </p>
          <ul class="mt-2 flex flex-col gap-1.5">
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="text-supporting text-brand-700 hover:underline">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose prose-neutral mt-6 max-w-none wrap-break-word text-body text-neutral-800">
      <Content />
    </div>

    {
      relatedGuides.length > 0 && (
        <div class="mt-12 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related guides</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {relatedGuides.map((related) => (
              <li>
                <a
                  href={`/guides/${related.id}/`}
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-card-heading text-neutral-950">{related.data.title}</p>
                  <p class="mt-1 text-supporting text-neutral-600">{related.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8 rounded-card border border-neutral-200 bg-neutral-50 p-6 text-center">
      <p class="text-card-heading text-neutral-950">See how this applies to your own site</p>
      <p class="mt-1.5 text-supporting text-neutral-600">
        Run a free audit to check your declared AI crawler policy against your own domain.
      </p>
      <a
        href="/audit"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Audit a domain
      </a>
    </div>
  </article>
</MarketingLayout>
