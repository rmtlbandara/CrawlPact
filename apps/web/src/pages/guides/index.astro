---
export const prerender = true;
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const guides = (await getCollection("guides")).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime(),
);
---

<MarketingLayout
  title="AI Crawler Policy Guides | CrawlPact"
  description="Decision, implementation, and troubleshooting guides for configuring AI crawler access in robots.txt and related signals."
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Guides</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      Practical guides for configuring and troubleshooting AI crawler policy — decision guides for
      choosing an approach, implementation guides for setting it up, and troubleshooting guides for
      when something doesn't behave as expected.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        guides.map((guide) => (
          <li class="rounded-card border border-neutral-200 bg-white p-5">
            <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
              {guide.data.category}
            </p>
            <h2 class="mt-1 text-card-heading text-neutral-950">
              <a href={`/guides/${guide.id}`} class="hover:text-brand-700">
                {guide.data.title}
              </a>
            </h2>
            <p class="mt-2 text-body text-neutral-700">{guide.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</MarketingLayout>
