---
export const prerender = false;
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../../components/AnalyticsBeacon";
import { createDb } from "@crawlpact/database";
import { getEnv } from "../../lib/env";
import { listPublishedResearchPublications } from "../../lib/admin/research";

Astro.response.headers.set("Cache-Control", "public, max-age=120");

const db = createDb(getEnv().DB);
const publications = await listPublishedResearchPublications(db);
// Section 73/110: don't index an empty "coming soon" page — noindex until
// there is at least one real publication to show.
const noindex = publications.length === 0;
---

<MarketingLayout
  title="Research | CrawlPact"
  description="Published Policy Observatory research: reproducible, source-backed findings about the AI crawler ecosystem."
  canonicalPath="/research/"
  noindex={noindex}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Observatory", url: "/observatory/" },
    { name: "Research", url: "/research/" },
  ]}
>
  <AnalyticsBeacon client:load eventName="research_index_viewed" />
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Research</h1>
    <p class="mt-3 text-body text-neutral-700">
      Published Policy Observatory research. Every publication states its dataset, methodology,
      exact numerators and denominators, and limitations — see{" "}
      <a href="/observatory/methodology/" class="text-brand-700 underline underline-offset-2">
        methodology
      </a>.
    </p>

    {
      publications.length === 0 ? (
        <p class="mt-8 rounded-card border border-neutral-200 bg-neutral-50 p-4 text-body text-neutral-700">
          CrawlPact hasn't published Policy Observatory research yet. In the meantime, explore the{" "}
          <a href="/observatory/registry/" class="text-brand-700 underline underline-offset-2">
            Registry Observatory
          </a>{" "}
          for current registry statistics.
        </p>
      ) : (
        <ol class="mt-8 flex flex-col gap-6 border-l border-neutral-200 pl-6">
          {publications.map((pub) => (
            <li>
              <p class="text-supporting text-neutral-500">
                {pub.publishedAt && new Date(pub.publishedAt).toLocaleDateString()}
                {pub.status === "corrected" && <span class="ml-2 text-amber-700">(corrected)</span>}
              </p>
              <a
                href={`/research/${pub.slug}/`}
                class="mt-1 block text-card-heading text-neutral-950 underline underline-offset-2"
              >
                {pub.title}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </article>
</MarketingLayout>
