---
export const prerender = false;
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { PasskeyAuth } from "../components/auth/PasskeyAuth";
import { createDb, schema } from "@crawlpact/database";
import { eq } from "drizzle-orm";
import { getEnv } from "../lib/env";
import { getPageSession } from "../lib/auth/page-session";
import { isSafeRelativeRedirect } from "../lib/auth/safe-redirect";
import { PLAN_COPY } from "../lib/billing/plan-catalog";
import type { PaidPlanId, BillingInterval } from "../lib/billing/plan-catalog";

const db = createDb(getEnv().DB);

// Phase 6 (Pricing, Plan Architecture and Checkout Continuity): the pricing page's own CTAs
// carry only a semantic `plan`/`interval` pair here — never a price ID or amount (see
// docs/security/PHASE_06_BILLING_AND_CHECKOUT_THREAT_REVIEW.md). This is display-copy-only, same
// as the continuation lookup below; the actual checkout still independently re-validates and
// resolves the real price server-side at /app/billing, regardless of what this page shows.
const PAID_PLAN_IDS = new Set<PaidPlanId>(["solo", "pro", "agency"]);
const BILLING_INTERVALS = new Set<BillingInterval>(["month", "year"]);
const requestedPlanRaw = Astro.url.searchParams.get("plan");
const requestedIntervalRaw = Astro.url.searchParams.get("interval");
const requestedPlan =
  requestedPlanRaw && PAID_PLAN_IDS.has(requestedPlanRaw as PaidPlanId)
    ? (requestedPlanRaw as PaidPlanId)
    : null;
const requestedInterval =
  requestedIntervalRaw && BILLING_INTERVALS.has(requestedIntervalRaw as BillingInterval)
    ? (requestedIntervalRaw as BillingInterval)
    : "year";

// Phase 5 (Anonymous Audit Result and Account-Conversion Flow): a "Save and monitor this
// domain" click carries an opaque continuation ID here as a query parameter, not report
// content — see docs/security/PHASE_05_AUDIT_CONVERSION_THREAT_REVIEW.md. This is a read-only
// lookup for display copy only; the continuation is not consumed here, only at the handoff
// route, which independently revalidates everything server-side regardless of what this page
// shows.
const continuationId = Astro.url.searchParams.get("continuation");
let continuationDomain: string | null = null;
let redirectTo = "/app";

if (continuationId && continuationId.length > 0 && continuationId.length <= 128) {
  const [continuation] = await db
    .select()
    .from(schema.auditContinuations)
    .where(eq(schema.auditContinuations.id, continuationId))
    .limit(1);
  // Only trust it for display copy if it's still genuinely usable — an expired/consumed
  // continuation shown here would be misleading; the handoff route shows the real expired
  // state regardless of what copy appears on this page.
  if (
    continuation &&
    !continuation.consumedAt &&
    continuation.expiresAt > new Date().toISOString()
  ) {
    continuationDomain = continuation.canonicalOrigin;
  }
  const target = `/app/continue?continuation=${encodeURIComponent(continuationId)}`;
  if (isSafeRelativeRedirect(target)) redirectTo = target;
} else if (requestedPlan) {
  // Only takes effect when no Phase 5 audit continuation is present — a visitor never arrives
  // with both a live continuation and a plan selection at once in practice, and the
  // continuation (an expiring, single-use record) takes priority if they somehow did.
  const target = `/app/billing?plan=${requestedPlan}&interval=${requestedInterval}`;
  if (isSafeRelativeRedirect(target)) redirectTo = target;
}

// Already-authenticated users should never see the sign-in form again (SRS-adjacent Phase 5
// requirement: "already authenticated users skip unnecessary authentication").
const session = await getPageSession(db, Astro.request);
if (session) {
  return Astro.redirect(redirectTo);
}

const heading = continuationDomain
  ? `Continue to save and monitor ${continuationDomain}`
  : requestedPlan
    ? `Create an account to subscribe to ${PLAN_COPY[requestedPlan].name}`
    : "Sign in";
const initialMode = continuationDomain || requestedPlan ? "signup" : "signin";
---

<MarketingLayout
  title="Sign in | CrawlPact"
  description="CrawlPact uses passkey (WebAuthn) sign-in. No password, no email."
  noindex={true}
>
  <div class="mx-auto max-w-[480px] px-4 py-20 sm:px-6">
    <h1 class="text-h1 text-neutral-950">{heading}</h1>
    {
      continuationDomain ? (
        <p class="mt-4 text-body-lg text-neutral-700">
          Your completed public audit remains available either way. Create an account or sign in to
          save this domain and set up monitoring.
        </p>
      ) : requestedPlan ? (
        <p class="mt-4 text-body-lg text-neutral-700">
          Create an account or sign in, then confirm your plan from your account's billing page.
        </p>
      ) : (
        <p class="mt-4 text-body-lg text-neutral-700">
          CrawlPact signs you in with a passkey — no password, no email, nothing to remember.
        </p>
      )
    }
    <p class="mt-3 text-body text-neutral-600">
      A passkey uses your device's built-in security — Face ID, Touch ID, Windows Hello, or a
      security key — instead of a password. Your browser will prompt you directly; CrawlPact never
      sees or stores the passkey itself. No passkey on this device? Use a recovery code instead.
    </p>
    <div class="mt-8">
      <PasskeyAuth client:load redirectTo={redirectTo} initialMode={initialMode} />
    </div>
  </div>
</MarketingLayout>
