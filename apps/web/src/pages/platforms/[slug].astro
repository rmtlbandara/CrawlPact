---
// Phase 7 (Vertical Landing Pages and Platform SEO Architecture). Prerendered, matching
// guides/crawlers — platform guides reference no live pricing data, so there is no D1-binding
// constraint (unlike /for/* — see docs/seo/SITEMAP_AND_INDEXABILITY_POLICY.md).
export const prerender = true;
import { getCollection, render } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../../components/AnalyticsBeacon";

export async function getStaticPaths() {
  const platforms = await getCollection("platforms");
  return platforms.map((platform) => ({ params: { slug: platform.id }, props: { platform } }));
}

const { platform } = Astro.props;
const { Content } = await render(platform);

const relatedGuides = platform.data.relatedGuideSlugs?.length
  ? (await getCollection("guides")).filter((g) => platform.data.relatedGuideSlugs?.includes(g.id))
  : [];
const relatedCrawlers = platform.data.relatedCrawlerSlugs?.length
  ? (await getCollection("crawlers")).filter((c) =>
      platform.data.relatedCrawlerSlugs?.includes(c.id),
    )
  : [];
const relatedPlatforms = platform.data.relatedPlatformSlugs?.length
  ? (await getCollection("platforms")).filter((p) =>
      platform.data.relatedPlatformSlugs?.includes(p.id),
    )
  : [];

const CATEGORY_LABEL: Record<string, string> = {
  managed_cdn: "Managed CDN",
  hosted_application: "Hosted application platform",
  deployment_platform: "Deployment platform",
  web_server: "Web server",
};
---

<MarketingLayout
  title={`${platform.data.title} | CrawlPact Platform Guides`}
  description={platform.data.description}
  canonicalPath={`/platforms/${platform.id}/`}
  ogImage="/og/platforms.png"
  ogType="article"
  publishedDate={platform.data.publishedDate}
  updatedDate={platform.data.updatedDate}
  breadcrumbs={[
    { name: "Platforms", url: "/platforms" },
    { name: platform.data.platformName, url: `/platforms/${platform.id}/` },
  ]}
>
  <article class="mx-auto max-w-reading px-4 py-12 sm:px-6">
    <p class="text-metadata font-medium uppercase tracking-wide text-neutral-500">
      {CATEGORY_LABEL[platform.data.platformCategory] ?? platform.data.platformCategory}
    </p>
    <h1 class="mt-1 text-h1 text-neutral-950">{platform.data.title}</h1>
    <p class="mt-3 text-body-lg text-neutral-700">{platform.data.summary}</p>
    <p class="mt-2 text-supporting text-neutral-500">
      Published {new Date(platform.data.publishedDate).toLocaleDateString()}
      {
        platform.data.updatedDate && (
          <> · Updated {new Date(platform.data.updatedDate).toLocaleDateString()}</>
        )
      }
      {" · "}Platform documentation verified{" "}
      {new Date(platform.data.platformDocsVerifiedDate).toLocaleDateString()}
    </p>

    <div class="mt-6">
      <a
        href="/audit"
        data-analytics-event="platform_audit_cta_clicked"
        class="rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Audit your deployed policy
      </a>
    </div>

    <div class="prose prose-neutral mt-10 max-w-none wrap-break-word text-body text-neutral-800">
      <Content />
    </div>

    <div class="mt-10 border-t border-neutral-200 pt-8">
      <h2 class="text-h3 text-neutral-950">Official references</h2>
      <p class="mt-2 text-supporting text-neutral-600">
        Every technical claim on this page traces to one of these sources.
      </p>
      <ul class="mt-4 flex flex-col gap-2">
        {
          platform.data.officialSources.map((source) => (
            <li>
              <a
                href={source.url}
                data-analytics-event="platform_official_source_clicked"
                rel="noopener noreferrer"
                target="_blank"
                class="text-body font-medium text-brand-700 underline underline-offset-2"
              >
                {source.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      relatedPlatforms.length > 0 && (
        <div class="mt-10 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related platform guides</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {relatedPlatforms.map((other) => (
              <li>
                <a
                  href={`/platforms/${other.id}/`}
                  data-analytics-event="platform_related_guide_clicked"
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-card-heading text-neutral-950">{other.data.title}</p>
                  <p class="mt-1 text-supporting text-neutral-600">{other.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      relatedGuides.length > 0 && (
        <div class="mt-10 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related guides</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {relatedGuides.map((guide) => (
              <li>
                <a
                  href={`/guides/${guide.id}/`}
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-card-heading text-neutral-950">{guide.data.title}</p>
                  <p class="mt-1 text-supporting text-neutral-600">{guide.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      relatedCrawlers.length > 0 && (
        <div class="mt-10 border-t border-neutral-200 pt-8">
          <h2 class="text-h3 text-neutral-950">Related crawlers</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {relatedCrawlers.map((crawler) => (
              <li>
                <a
                  href={`/crawlers/${crawler.id}/`}
                  class="block rounded-card border border-neutral-200 bg-white p-4 hover:border-brand-300"
                >
                  <p class="text-card-heading text-neutral-950">{crawler.data.name}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div
      class="mt-10 rounded-card border border-neutral-200 bg-neutral-50 p-5 text-supporting text-neutral-600"
    >
      Found an outdated platform instruction or source? Send the affected page and supporting
      official documentation to{" "}
      <a
        href="mailto:support@crawlpact.com"
        data-analytics-event="content_correction_clicked"
        class="text-brand-700 underline underline-offset-2"
      >
        support@crawlpact.com
      </a>
      . We respond to enquiries within 24 hours.
    </div>
  </article>
  <AnalyticsBeacon
    client:load
    eventName="platform_guide_viewed"
    properties={{ platform: platform.id }}
  />
</MarketingLayout>

<script>
  // Lightweight, unhydrated click-delegation for platform-guide CTA analytics (Phase 7) — same
  // pattern as /for/[slug].astro and index.astro's homepage conversion-path tracking.
  document.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>("[data-analytics-event]");
    if (!target) return;
    const eventName = target.dataset.analyticsEvent;
    if (!eventName) return;
    fetch("/api/analytics/track", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ eventName }),
      keepalive: true,
    }).catch(() => {
      // Analytics must never surface an error to the user.
    });
  });
</script>
