---
export const prerender = true;
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { AnalyticsBeacon } from "../../components/AnalyticsBeacon";

const platforms = (await getCollection("platforms")).sort((a, b) =>
  a.data.platformName.localeCompare(b.data.platformName),
);

const CATEGORY_ORDER = [
  "managed_cdn",
  "hosted_application",
  "deployment_platform",
  "web_server",
] as const;
const CATEGORY_LABEL: Record<(typeof CATEGORY_ORDER)[number], string> = {
  managed_cdn: "Managed CDN",
  hosted_application: "Hosted application platforms",
  deployment_platform: "Deployment platforms",
  web_server: "Web servers",
};
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABEL[category],
  platforms: platforms.filter((p) => p.data.platformCategory === category),
})).filter((group) => group.platforms.length > 0);
---

<MarketingLayout
  title="AI crawler policy by platform | CrawlPact"
  description="Verified, source-cited implementation guides for how AI crawler policy signals work on Cloudflare, WordPress, Shopify, Vercel, Netlify, and other platforms."
  ogImage="/og/platforms.png"
  breadcrumbs={[{ name: "Platforms", url: "/platforms" }]}
>
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6">
    <h1 class="text-h1 text-neutral-950">Platform guides</h1>
    <p class="mt-3 max-w-2xl text-body-lg text-neutral-700">
      How AI crawler policy signals — <code>robots.txt</code>, meta directives, and response headers
      — actually work on specific hosting platforms and CDNs. Platform behaviour can change; every
      guide below shows when its official sources were last verified, and links directly to them.
    </p>

    {
      groups.map((group) => (
        <section class="mt-10">
          <h2 class="text-h2 text-neutral-950">{group.label}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.platforms.map((platform) => (
              <li class="rounded-card border border-neutral-200 bg-white p-5">
                <h3 class="text-card-heading text-neutral-950">
                  <a href={`/platforms/${platform.id}/`} class="hover:text-brand-700">
                    {platform.data.platformName}
                  </a>
                </h3>
                <p class="mt-2 text-body text-neutral-700">{platform.data.description}</p>
                <p class="mt-3 text-metadata text-neutral-500">
                  Verified {new Date(platform.data.platformDocsVerifiedDate).toLocaleDateString()}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="mt-12 rounded-card border border-neutral-200 bg-neutral-50 p-6 text-center">
      <p class="text-card-heading text-neutral-950">Check your own deployed policy</p>
      <p class="mt-1.5 text-supporting text-neutral-600">
        Run a free audit to see exactly what your domain currently tells AI crawlers, regardless of
        which platform serves it.
      </p>
      <a
        href="/audit"
        class="mt-4 inline-block rounded-control bg-brand-600 px-5 py-2.5 text-body font-medium text-white hover:bg-brand-700"
      >
        Audit a domain
      </a>
    </div>
  </div>
  <AnalyticsBeacon client:load eventName="platform_guide_viewed" properties={{ platform: "hub" }} />
</MarketingLayout>
