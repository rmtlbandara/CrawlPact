# CrawlPact — sample environment file
#
# Copy to `.dev.vars` for local Wrangler/Astro development:
#   cp .env.example .dev.vars
#
# NEVER commit a real .dev.vars or .env file. Only this example file, with
# placeholder values, belongs in version control.
#
# See docs/deployment/ENVIRONMENTS.md and docs/deployment/CLOUDFLARE_CONFIGURATION.md
# for how each variable is used and where production values are configured
# (Cloudflare Worker secrets, never the repository).

# --- Runtime ---------------------------------------------------------------
# One of: local | preview | production
PUBLIC_APP_ENV=local

# Canonical public origin for the current environment (used for absolute URLs,
# structured data, and redirects).
PUBLIC_SITE_URL=http://localhost:4321

# --- Cloudflare D1 -----------------------------------------------------------
# Bound automatically by Wrangler locally (see apps/web/wrangler.jsonc).
# No connection string is required for D1; this placeholder documents that the
# binding name is `DB` and is intentionally not a real secret.
D1_BINDING_NAME=DB

# --- Session / WebAuthn (Part 3) --------------------------------------------
# 32+ byte random value used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SIGNING_SECRET=replace-with-a-generated-secret

# The relying party ID/origin WebAuthn ceremonies are bound to.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:4321

# --- Paddle Billing (sandbox placeholders, Part 2 Step 17) ------------------
# Paddle sandbox API key (secret — server-side only). Never set a live
# Paddle key outside Cloudflare's encrypted secret store.
PADDLE_API_KEY=paddle_sandbox_placeholder
PADDLE_ENVIRONMENT=sandbox
# Signing secret used to verify inbound Paddle webhooks (see
# docs/security/BILLING_SECURITY.md).
PADDLE_WEBHOOK_SECRET=replace-with-paddle-sandbox-webhook-secret
# Paddle sandbox price IDs, one per plan, configured in the Paddle dashboard.
PADDLE_PRICE_ID_SOLO=pri_sandbox_placeholder
PADDLE_PRICE_ID_PRO=pri_sandbox_placeholder
PADDLE_PRICE_ID_AGENCY=pri_sandbox_placeholder
# Paddle's client-side token for Paddle.js — this one is *meant* to be
# public (it authorises opening a checkout, nothing more), unlike
# PADDLE_API_KEY above. Prefixed PUBLIC_ per this repo's convention for
# browser-exposed variables.
PUBLIC_PADDLE_CLIENT_TOKEN=paddle_sandbox_client_token_placeholder

# --- Feature flags -----------------------------------------------------------
# Deployment-intent flag: whether this environment should serve real
# checkouts/portal sessions at all. Independent of whether the Paddle values
# above are real — local/preview must always be "false" (see
# packages/config/src/env.ts's cross-field validation, which rejects a live
# PADDLE_ENVIRONMENT outside production regardless of this flag). Only
# production sets this to "true".
BILLING_ENABLED=false

# Part 1 ships the audit UI shell without a live scanner. This flag must
# remain "false" until Part 2 implements real scanning; the API must never
# fabricate findings when it is false. See docs/status/KNOWN_RISKS.md.
AUDIT_ENGINE_ENABLED=false
