{
  "name": "crawlpact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CrawlPact - AI crawler policy audit and monitoring platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @crawlpact/web dev",
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter @crawlpact/web build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:a11y:chromium": "playwright test --config=playwright.a11y.config.ts --project=chromium",
    "ui:review": "node --experimental-strip-types scripts/ui-review.ts",
    "db:migrate": "pnpm --filter @crawlpact/database run migrate:local",
    "db:migrate:remote": "pnpm --filter @crawlpact/database run migrate:remote",
    "db:seed": "pnpm --filter @crawlpact/database run seed:local",
    "db:seed:reference-data:remote": "pnpm --filter @crawlpact/database run seed:reference-data:remote",
    "db:validate": "pnpm --filter @crawlpact/database run validate",
    "db:reset:local": "pnpm --filter @crawlpact/database run reset:local",
    "registry:validate": "node scripts/registry-tools.mjs validate",
    "registry:checksum": "node scripts/registry-tools.mjs checksum",
    "registry:changelog": "node scripts/registry-tools.mjs changelog",
    "baseline:validate": "node scripts/baseline-validate.mjs",
    "docs:validate": "node scripts/docs-validate.mjs",
    "brand:validate": "node scripts/brand-validate.mjs",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration && pnpm run db:validate && pnpm run build",
    "check:fast": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "verify:push": "bash scripts/verify-push.sh",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "lighthouse:check": "node scripts/lighthouse-check.mjs",
    "env:validate": "node --experimental-strip-types scripts/env-validate.ts",
    "env:validate:local": "node --experimental-strip-types scripts/env-validate.ts local",
    "env:validate:preview": "node --experimental-strip-types scripts/env-validate.ts preview",
    "env:validate:production": "node --experimental-strip-types scripts/env-validate.ts production",
    "release:check": "pnpm run quality",
    "build:preview": "bash scripts/build.sh preview",
    "build:production": "bash scripts/build.sh production",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "deploy:production": "bash scripts/deploy.sh production",
    "deploy:verify-bindings": "node --experimental-strip-types scripts/verify-bindings.ts",
    "smoke:preview": "node --experimental-strip-types scripts/smoke-test.ts preview https://crawlpact-web-preview.rmtlbandara.workers.dev",
    "smoke:production": "node --experimental-strip-types scripts/smoke-test.ts production https://crawlpact.com"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.8.0",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
