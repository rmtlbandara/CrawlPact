{
  "name": "crawlpact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CrawlPact - AI crawler policy audit and monitoring platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @crawlpact/web dev",
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter @crawlpact/web build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:a11y:chromium": "playwright test --config=playwright.a11y.config.ts --project=chromium",
    "ui:review": "node --experimental-strip-types scripts/ui-review.ts",
    "db:migrate": "pnpm --filter @crawlpact/database run migrate:local",
    "db:migrate:remote": "pnpm --filter @crawlpact/database run migrate:remote",
    "db:seed": "pnpm --filter @crawlpact/database run seed:local",
    "db:seed:reference-data:remote": "pnpm --filter @crawlpact/database run seed:reference-data:remote",
    "db:seed:reference-data:remote:preview": "pnpm --filter @crawlpact/database run seed:reference-data:remote:preview",
    "db:validate": "pnpm --filter @crawlpact/database run validate",
    "db:reset:local": "pnpm --filter @crawlpact/database run reset:local",
    "registry:validate": "node scripts/registry-tools.mjs validate",
    "registry:checksum": "node scripts/registry-tools.mjs checksum",
    "registry:checksum:verify": "node scripts/registry-tools.mjs checksum:verify",
    "registry:integrity:verify": "node scripts/registry-tools.mjs integrity:verify",
    "registry:changelog": "node scripts/registry-tools.mjs changelog",
    "registry:public:validate": "node scripts/registry-public-validate.mjs",
    "research:validate": "node scripts/research-tools.mjs validate",
    "research:integrity:verify": "node scripts/research-tools.mjs integrity:verify",
    "pilot:validate": "node scripts/pilot-validate.mjs",
    "baseline:validate": "node scripts/baseline-validate.mjs",
    "docs:validate": "node scripts/docs-validate.mjs",
    "brand:validate": "node scripts/brand-validate.mjs",
    "trust:validate": "node scripts/trust-validate.mjs",
    "status:validate": "node scripts/status-validate.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "content:links:check": "node scripts/content-links-check.mjs",
    "repo-privacy:validate": "node scripts/repo-privacy-validate.mjs",
    "analytics:validate": "node scripts/analytics-validate.mjs",
    "operations:validate": "node scripts/operations-validate.mjs",
    "quality:gate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration && pnpm run test:security && pnpm run db:validate && pnpm run docs:validate && pnpm run brand:validate && pnpm run trust:validate && pnpm run status:validate && pnpm run operations:validate && pnpm run db:migrate && (pnpm run db:seed || true) && pnpm run registry:validate && pnpm run registry:integrity:verify && pnpm run registry:public:validate && pnpm run research:validate && pnpm run research:integrity:verify && pnpm run pilot:validate && pnpm run content:validate && pnpm run repo-privacy:validate && pnpm run analytics:validate && pnpm audit --audit-level=critical && pnpm run build && pnpm run repo-privacy:validate",
    "quality": "pnpm run quality:gate",
    "check:fast": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "verify:push": "bash scripts/verify-push.sh",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "lighthouse:check": "node scripts/lighthouse-check.mjs",
    "env:validate": "node --experimental-strip-types scripts/env-validate.ts",
    "env:validate:local": "node --experimental-strip-types scripts/env-validate.ts local",
    "env:validate:preview": "node --experimental-strip-types scripts/env-validate.ts preview",
    "env:validate:production": "node --experimental-strip-types scripts/env-validate.ts production",
    "release:check": "pnpm run quality",
    "build:preview": "bash scripts/build.sh preview",
    "build:production": "bash scripts/build.sh production",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "deploy:production": "bash scripts/deploy.sh production",
    "deploy:verify-bindings": "node --experimental-strip-types scripts/verify-bindings.ts",
    "smoke:preview": "node --experimental-strip-types scripts/smoke-test.ts preview https://crawlpact-web-preview.rmtlbandara.workers.dev",
    "smoke:production": "node --experimental-strip-types scripts/smoke-test.ts production https://crawlpact.com",
    "paddle:catalog:verify": "node --experimental-strip-types scripts/paddle-catalog-verify.ts",
    "performance:scan": "vitest run --project integration apps/web/tests/integration/persist-scan-benchmark.integration.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.11.0",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0",
    "yaml": "2.9.0"
  }
}
